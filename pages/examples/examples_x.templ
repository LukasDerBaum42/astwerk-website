package examples

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	x "github.com/LukasDerBaum42/astwerk-live/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// State for the compiled-markup demos. Each demo page is its own HTML file,
// and every page's own Document names its signals independently, so these
// package-level values are shared safely: the build only ever reads them.
var (
	XCount  = x.NamedNumSignal("count", 0)
	XDouble = x.Computed(x.Mul(XCount, 2))

	XPrice = x.NewNumSignal(12.0)
	XQty   = x.NewNumSignal(2.0)
	XTotal = x.Computed(x.Mul(XPrice, XQty))
	XTax   = x.NewBoolSignal(false)
	XTaxed = x.Computed(x.Mul(XTotal, 1.19))

	XTodos = x.NamedListSignal("todos", []XTodo{
		{ID: "1", Text: "Read the docs"},
		{ID: "2", Text: "Build something"},
	})
	XDraft = x.NamedStrSignal("draft", "")

	BURL     = x.NewStrSignal("https://templ.guide")
	BActive  = x.NewBoolSignal(true)
	BBusy    = x.NewBoolSignal(false)
	BPressed = x.NamedStrSignal("pressed", "false")
	BColour  = x.NewStrSignal("#4f7cff")

	XPosts   = x.NamedListSignal("posts", []XPost{{ID: "0", Title: "Rendered at build time"}})
	XLoading = x.NamedBoolSignal("loading", false)

	XFaq1 = x.NamedBoolSignal("faq1", true)
	XFaq2 = x.NamedBoolSignal("faq2", false)
	XFaq3 = x.NamedBoolSignal("faq3", false)

	HoodCount = x.NamedNumSignal("hood", 0)

	// XShared is the bridge demo's cell: a named signal the WASM half mirrors
	// with reactive.XNum — the terminology matrix's proof.
	XShared = x.NamedNumSignal("shared", 0)
)

// XTodo is one keyed-list row. The json tags are the field names the browser
// half of the list reads, so they are part of the contract with todoRow below.
type XTodo struct {
	ID   string `json:"id"`
	Text string `json:"text"`
}

// XPost is one async-demo row, with the same contract as XTodo.
type XPost struct {
	ID    string `json:"id"`
	Title string `json:"title"`
}

templ ExampleXCounter(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A counter</h1>
		<p class="lede">
			The same counter as the WASM demo — a signal, a computed double, and
			+/−/reset handlers — but the JavaScript was generated at build time by
			the markers themselves. No <code>.wasm</code>, no runtime to download;
			view source, and the bindings are right there in this page's HTML.
		</p>
		@x.Document(xCounterDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xCounterStateSrc) {
			<p>
				<code>x.NamedNumSignal</code> creates the state under a fixed
				name, so scripts can read it as <code>count.get()</code>.
				<code>x.Computed</code> derives the double from it — the expression
				is evaluated at build time for the static value and compiled to
				JavaScript that recomputes it when count changes.
			</p>
		}
		@templates.PieceTempl("The buttons", xCounterButtonsSrc) {
			<p>
				<code>x.El</code> renders a button with its bindings attached.
				<code>x.On</code> binds a click handler whose action is one word:
				<code>Dec</code> and <code>Inc</code> change the signal by one,
				<code>SetTo</code> resets it. The minus button is the
				quantity-counter pattern: <code>x.If</code> guards the decrement so
				it can't go below zero, and <code>x.Disabled</code> takes a memo
				wrapping a comparison — the only way a binding accepts an
				expression. The body is the button's
				content — <code>{ "@" }x.Text(XCount)</code> renders the value and
				the binding that keeps it in sync, so the button shows the count as
				it changes.
			</p>
		}
		@templates.PieceTempl("The derived value", xCounterDerivedSrc) {
			<p>
				For the memo, <code>{ "@" }x.Text(XDouble)</code> does the same: renders
				the current value and keeps it in sync as count changes.
			</p>
		}
		@templates.FullSourceTempl(xCounterSrc)
		<details>
			<summary>What Document emits</summary>
			<p>
				<code>x.Document</code> renders its body and emits the runtime and
				state declarations before the markup, the bindings after it. Outside
				a Document the markers render plain static HTML — a page with no
				markers ships no script at all.
			</p>
		</details>
		<p>
			The full marker set is documented in
			<a href={ c.Link("docs/x/") }>x — compiled reactive markup</a>.
		</p>
	}
}

templ ExampleXForms(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Forms and computed values</h1>
		<p class="lede">
			Two number inputs bound two-way, a total derived from them, and a
			checkbox that includes 19% tax in the total. The totals are
			<code>x.Computed</code> — recomputed in the browser whenever either
			input changes.
		</p>
		@x.Document(xFormsDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xFormsStateSrc) {
			<p>
				Two signals for the inputs; the totals are derived from them with
				<code>x.Computed</code> — <code>Mul</code> is a combinator compiled to
				JavaScript, so the totals recompute in the browser. The taxed total
				chains: <code>Mul(XTotal, 1.19)</code> derives from the derived.
			</p>
		}
		@templates.PieceTempl("The inputs", xFormsInputsSrc) {
			<p>
				<code>x.Number</code> is two-way — typing writes the signal, setting
				the signal updates the field — and input that isn't a number is
				ignored. <code>x.Text</code> renders the computed totals.
			</p>
		}
		@templates.PieceTempl("The checkbox", xFormsCheckboxSrc) {
			<p>
				<code>x.Checkbox</code> two-way binds a bool, and <code>x.Show</code>
				lets that same signal drive each total's visibility — both spans stay
				live, exactly one shows. The second is the inverse:
				<code>x.Not</code> negates the signal inside a memo, so the plain and
				the taxed total can never both show. The checkbox genuinely changes
				the value on the page: tick it and the total gains 19%. The marker
				set has no formatter, so the number renders raw — type a price the
				floats can't say exactly and the noise shows; formatting is a
				program, which is the escape hatch's job (or the WASM twin's
				<code>%.2f</code>).
			</p>
		}
		@templates.FullSourceTempl(xFormsSrc)
		<details>
			<summary>Why two-way doesn't feed back</summary>
			<p>
				Typing fires an input event that writes the signal; the reverse
				direction is a plain value assignment, which doesn't fire an input
				event. The two directions never chase each other.
			</p>
		</details>
	}
}

templ ExampleXTodo(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A keyed list</h1>
		<p class="lede">
			The two rows were rendered at build time; the rest is a keyed list —
			adding a row inserts one node, never rebuilds the others. The add and
			remove handlers are a script, which is the escape hatch: anything a
			combinator can't say is plain JavaScript reading the named signals.
		</p>
		@x.Document(xTodoDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xTodoStateSrc) {
			<p>
				The JSON tags are the field names the browser half of the list reads,
				so they are part of the contract with <code>todoRow</code>. The two
				initial rows were rendered at build time; everything after that
				happens in the browser.
			</p>
		}
		@templates.PieceTempl("The list", xTodoListSrc) {
			<p>
				<code>x.List</code> takes the signal, the JSON field that keys each
				item, a Go renderer for rows present at build time, and the name of a
				JavaScript function that renders rows added in the browser. Rows are
				keyed by <code>id</code>: adding or removing an item moves or detaches
				one node, and every other row is untouched.
			</p>
		}
		@templates.PieceTempl("The script", xTodoScriptSrc) {
			<p>
				Appending to the array is one of the few things combinators can't say,
				so it's a script: <code>draft.get()</code> reads the input signal,
				<code>todos.set(...)</code> replaces the list, and
				<code>draft.set("")</code> clears the field — which the two-way
				binding echoes back.
			</p>
		}
		@templates.PieceTempl("The count", xTodoCountSrc) {
			<p>
				The remaining count is an effect: it reads
				<code>todos.get()</code>, so it re-runs whenever the list changes
				and rewrites the line.
			</p>
		}
		@templates.FullSourceTempl(xTodoSrc)
		<details>
			<summary>Why rows are keyed by id</summary>
			<p>
				The key is what makes the list patch instead of re-render: the
				browser can tell "this row moved" from "this is a new row". An item
				whose key changes is treated as a new item.
			</p>
		</details>
	}
}

templ ExampleXAsync(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Async data</h1>
		<p class="lede">
			The WASM async demo through the script escape hatch: a fake fetch that
			takes half a second, a loading signal, and a keyed list — with no WASM
			and no framework. The WASM version is
			<a href={ c.Link("examples/async/") }>Async data</a>.
		</p>
		@x.Document(xAsyncDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xAsyncStateSrc) {
			<p>
				Two named signals: the posts, and a loading flag the script toggles.
				Named, because the script below reads and writes them directly.
			</p>
		}
		@templates.PieceTempl("The list", xAsyncListSrc) {
			<p>
				<code>x.List</code> renders the posts statically at build time — the
				one row that exists before any script runs — and keeps the list in
				sync as the script replaces the signal.
			</p>
		}
		@templates.PieceTempl("The script", xAsyncScriptSrc) {
			<p>
				Combinators stop where a real program begins: timing, fetching, side
				effects. That is the escape hatch — a plain script reading the named
				signals. It flips <code>loading</code>, waits, replaces
				<code>posts</code>, and updates the status line directly.
			</p>
		}
		@templates.FullSourceTempl(xAsyncSrc)
		<details>
			<summary>Why this is a script, not a marker</summary>
			<p>
				The marker set covers state, bindings and structure. Async work has
				no combinator — it is a program, so it is a script. That boundary is
				deliberate: the script escape hatch is what keeps the markers from
				having to grow into a language.
			</p>
		</details>
	}
}

templ ExampleXFaq(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Conditional content</h1>
		<p class="lede">
			A FAQ is a handful of <code>x.When</code> subtrees: a button toggles a
			bool with <code>x.Not</code>, and the answer mounts and unmounts as it
			changes. The first answer is open at build time, so the page reads
			correctly with JavaScript disabled — and with it on, the answers
			appear and disappear in place.
		</p>
		@x.Document(xFaqDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xFaqStateSrc) {
			<p>
				One bool per question. The first starts open, so the page has
				static content; the rest start closed.
			</p>
		}
		@templates.PieceTempl("The toggle", xFaqToggleSrc) {
			<p>
				<code>Toggle</code> flips the signal, so clicking always toggles it —
				no if/else. <code>x.Class("on", …)</code> highlights the open
				questions, so the state is visible before you read any answers.
			</p>
		}
		@templates.PieceTempl("The answer", xFaqWhenSrc) {
			<p>
				<code>x.When</code> takes the condition and the subtree to mount —
				a plain templ component. It mounts while the condition is true and
				unmounts when it turns false, and the HTML is captured at build
				time, so the answer is in the page source before any script runs.
			</p>
		}
		@templates.FullSourceTempl(xFaqSrc)
		<details>
			<summary>When vs Show</summary>
			<p>
				<code>x.Show</code> keeps the same nodes and toggles visibility, so
				input focus and scroll position inside them survive.
				<code>x.When</code> removes the subtree entirely and rebuilds it
				from the captured HTML on remount — right for content rebuilt from
				state, wrong for a form you'd like to keep typing in.
			</p>
		</details>
	}
}

templ xCounterDemo() {
	<div class="demo">
		<div class="counter-row">
			@x.El("button",
				x.On("click", x.If(x.Computed(x.Gt(XCount, 0)), XCount.Dec(1))),
				x.Disabled(x.Computed(x.Lte(XCount, 0))),
				x.HtmlAttr("aria-label", "Decrement"),
			) {
				&minus;
			}
			@x.El("span", x.HtmlAttr("class", "counter-value")) {
				@x.Text(XCount)
			}
			@x.El("button", x.On("click", XCount.Inc(1))) {
				+
			}
			@x.El("button", x.On("click", XCount.SetTo(0))) {
				reset
			}
		</div>
		<p class="demo-note">Double: <span>@x.Text(XDouble)</span></p>
	</div>
}

templ xFormsDemo() {
	<div class="demo">
		<p><label>Price</label> @x.Number(XPrice)</p>
		<p><label>Quantity</label> @x.Number(XQty)</p>
		<p class="demo-note">
			Total:
			@x.El("span", x.Show(x.Computed(x.Not(XTax)))) {
				@x.Text(XTotal)
			}
			@x.El("span", x.Show(XTax)) {
				@x.Text(XTaxed)
			}
		</p>
		<p>@x.Checkbox(XTax) <label>include 19% tax</label></p>
	</div>
}

templ xTodoDemo() {
	<div class="demo">
		<form class="todo-form" data-x-form>
			@x.Input(XDraft)
			<button type="submit">Add</button>
		</form>
		<div data-x-list class="todo-list">
			@x.List(XTodos, "id", xTodoRow, "todoRow")
		</div>
		<p class="demo-note"><span data-x-remaining>2 remaining</span></p>
		@xTodoScript()
		@x.Effect() {
			<script>
				document.querySelector("[data-x-remaining]").textContent = todos.get().length + " remaining";
			</script>
		}
	</div>
}

templ xAsyncDemo() {
	<div class="demo">
		<div class="counter-row">
			<button type="button" data-x-reload>Reload</button>
			@x.El("span", x.Show(XLoading)) {
				Loading…
			}
		</div>
		<p class="demo-note" data-x-status>1 post rendered at build time</p>
		<div data-x-list class="todo-list">
			@x.List(XPosts, "id", xPostRow, "postRow")
		</div>
		@xAsyncScript()
	</div>
}

// xAsyncScript is the escape hatch carrying the fake fetch: it reads and
// writes the named signals, and defines the row template the list uses for
// items that appear at runtime.
templ xAsyncScript() {
	<script>
		function postRow(p) {
			return "<li>" + p.title + "</li>";
		}
		const status = document.querySelector("[data-x-status]");
		function load() {
			loading.set(true);
			status.textContent = "Loading…";
			setTimeout(() => {
				posts.set([
					{ id: "1", title: "Signals track their own dependencies" },
					{ id: "2", title: "Keyed lists move nodes instead of rebuilding them" },
					{ id: "3", title: "Scripts are the escape hatch — this is one" },
				]);
				loading.set(false);
				status.textContent = posts.get().length + " posts loaded";
			}, 500);
		}
		document.querySelector("[data-x-reload]").addEventListener("click", load);
		load();
	</script>
}

templ xFaqDemo() {
	<div class="demo">
		@x.El("button", x.On("click", XFaq1.Toggle()), x.Class("on", XFaq1)) {
			What is compiled markup?
		}
		@x.When(XFaq1, xFaqAnswer("The markers render at build time and subscribe in the browser — the page reads correctly with JavaScript disabled."))
		@x.El("button", x.On("click", XFaq2.Toggle()), x.Class("on", XFaq2)) {
			When should I reach for WebAssembly instead?
		}
		@x.When(XFaq2, xFaqAnswer("When the behaviour is a program — canvas, fetching, timers. Markers cover state, bindings and structure; everything else is Go in the browser."))
		@x.El("button", x.On("click", XFaq3.Toggle()), x.Class("on", XFaq3)) {
			What happens without JavaScript?
		}
		@x.When(XFaq3, xFaqAnswer("The page keeps its static form — the first answer is already open. Nothing needs a script to be readable."))
	</div>
}

// xFaqAnswer is one answer body — the subtree x.When mounts and unmounts.
templ xFaqAnswer(text string) {
	<p class="demo-note">{ text }</p>
}

templ ExampleXBindings(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Attribute bindings</h1>
		<p class="lede">
			Everything a value can do to an element: <code>x.Attr</code>,
			<code>x.Class</code>, <code>x.Disabled</code> and <code>x.Style</code>.
			Each one owns its property — use the buttons to change the signals and
			watch each element update on its own, nothing else re-renders.
		</p>
		@x.Document(xBindingsDemo(), templates.XOptions()...)

		<h2>How it works</h2>
		@templates.PieceTempl("State", xBindingsStateSrc) {
			<p>
				One signal per property the demo touches: the link target, the class,
				the disabled flag and the colour.
			</p>
		}
		@templates.PieceTempl("The elements", xBindingsElementsSrc) {
			<p>
				Each binding owns one property of one element. <code>x.Attr</code>
				sets a string attribute and removes it when empty; <code>x.Class</code>
				toggles one class; <code>x.Disabled</code> toggles the boolean
				attribute — present or absent, not true or false; <code>x.Style</code>
				sets one CSS property through <code>style.setProperty</code>.
			</p>
		}
		@templates.PieceTempl("The buttons", xBindingsButtonsSrc) {
			<p>
				Each button writes its signal with a one-word action:
				<code>Toggle</code> flips, <code>SetTo</code> stores a constant —
				except the disabled toggle, which needs both: <code>Seq</code> runs
				the flip and then an <code>x.If</code> that writes the toggle's
				<code>aria-pressed</code> from the just-flipped signal. The save
				button's state is visible twice — a <code>Show</code>/<code>Not</code>
				pair of spans under it, and the toggle's own <code>.on</code> class.
				Because each binding owns its property, changing one signal updates
				exactly that element's property — nothing else re-renders.
			</p>
		}
		@templates.FullSourceTempl(xBindingsSrc)
		<details>
			<summary>How the static value renders</summary>
			<p>
				Every binding renders its current value into the HTML at build time —
				the page reads correctly with JavaScript disabled — and subscribes to
				the signal for updates.
			</p>
		</details>
	}
}

templ ExampleXUnderTheHood(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>What the markers generate</h1>
		<p class="lede">
			The widget below was rendered at build time, and so was everything
			around it: the blocks beneath it are the exact HTML and script the
			build emitted for it, with only the runtime elided. View source to see
			the whole page, runtime included.
		</p>
		@x.Document(hoodDemo(), templates.XOptions()...)

		<h2>The source</h2>
		@templates.PieceTempl("State", hoodStateSrc) {
			<p>
				One named signal. Named, so the script the build emits can declare it
				as a real variable.
			</p>
		}
		@templates.PieceTempl("The widget", hoodWidgetSrc) {
			<p>
				A button whose click handler increments the signal, with the value
				rendered inside it via <code>x.Text</code>.
			</p>
		}

		<h2>The generated HTML</h2>
		<p>
			Each marker stamps its own element with <code>data-x</code> and
			renders the current value — this is the page's markup, static before
			any script runs.
		</p>
		@templates.CodeBlockHTML(hoodHTML())
		<h2>The generated script</h2>
		<p>
			The runtime (omitted here) declares the signal, and the footer binds
			it to the stamped nodes. There is nothing to diff and nothing to
			re-render: a click runs <code>hood.set(hood.get() + 1)</code> and the
			text binding writes the new value.
		</p>
		@templates.CodeBlockJS(hoodJS())
		<details>
			<summary>The runtime, elided here</summary>
			<p>
				The runtime is assembled per page from fragments — a counter page
				ships roughly the runtime for a counter, not a framework. The full
				output, runtime included, is in this page's source.
			</p>
		</details>
	}
}

templ xBindingsDemo() {
	<div class="demo">
		<p>@x.El("a", x.Attr("href", BURL)) { templ.guide }</p>
		<p>@x.El("span", x.Class("on", BActive)) { a toggled class }</p>
		<p>@x.El("button", x.Disabled(BBusy)) { save }</p>
		<p class="demo-note">
			@x.El("span", x.Show(x.Computed(x.Not(BBusy)))) {
				the save button is enabled
			}
			@x.El("span", x.Show(BBusy)) {
				the save button is disabled
			}
		</p>
		<p>@x.El("span", x.Style("color", BColour)) { styled text }</p>
		<div class="counter-row">
			@x.El("button", x.On("click", BActive.Toggle())) {
				toggle class
			}
			@x.El("button",
				x.On("click", x.Seq(BBusy.Toggle(), x.If(BBusy, BPressed.SetTo("true"), BPressed.SetTo("false")))),
				x.Class("on", BBusy),
				x.Attr("aria-pressed", BPressed),
			) {
				toggle disabled
			}
			@x.El("button", x.On("click", BColour.SetTo("#ff4f7c"))) {
				recolour
			}
			@x.El("button", x.On("click", BURL.SetTo("https://pkg.go.dev/github.com/LukasDerBaum42/astwerk"))) {
				retarget link
			}
		</div>
	</div>
}

templ hoodDemo() {
	<div class="demo">
		@x.El("button", x.On("click", HoodCount.Inc(1))) {
			@x.Text(HoodCount) +
		}
	</div>
}

// bridgeXDemo is the compiled-markup half of the bridge demo: a counter over
// the shared named cell. The WASM half mirrors the same cell with XNum, so
// clicking either side updates both.
templ bridgeXDemo() {
	<div class="bridge-side" id="bridge-x">
		<p class="bridge-title">x &mdash; compiled markup</p>
		<div class="counter-row">
			@x.El("button", x.On("click", XShared.Dec(1))) {
				&minus;
			}
			<span class="counter-value">@x.Text(XShared)</span>
			@x.El("button", x.On("click", XShared.Inc(1))) {
				+
			}
		</div>
	</div>
}

// xTodoRow renders a row present at build time — the static half of the list.
templ xTodoRow(item XTodo) {
	<li>{ item.Text } <button data-remove={ item.ID }>remove</button></li>
}

// xPostRow renders a post present at build time — the async demo's static half.
templ xPostRow(p XPost) {
	<li>{ p.Title }</li>
}

// xTodoScript is the client-side half: the row template for items added in the
// browser, and the add/remove handlers. Anything a combinator cannot say is a
// script — and scripts read the named signals directly.
templ xTodoScript() {
	<script>
		const esc = (s) => String(s).replace(/[&<>"]/g, (c) => "&#" + c.charCodeAt(0) + ";");
		function todoRow(item) {
			return `<li>${esc(item.text)} <button data-remove="${item.id}">remove</button></li>`;
		}
		document.querySelector("[data-x-form]").addEventListener("submit", (e) => {
			e.preventDefault();
			const text = draft.get();
			if (!text) return;
			todos.set([...todos.get(), { id: String(Date.now()), text }]);
			draft.set("");
		});
		document.querySelector("[data-x-list]").addEventListener("click", (e) => {
			const btn = e.target.closest("[data-remove]");
			if (!btn) return;
			todos.set(todos.get().filter((t) => t.id !== btn.dataset.remove));
		});
	</script>
}
