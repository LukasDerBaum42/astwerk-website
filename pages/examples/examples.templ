package examples

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	x "github.com/LukasDerBaum42/astwerk-live/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// ExampleNav is the sidebar for every page under examples/, in reading order:
// the compiled-markup demos first (the recommended path), then the WASM demos —
// most WASM demos have a compiled-markup twin with the same behaviour, so the
// two implementations can be compared feature for feature. The deliberate
// exceptions are the canvas demo (a canvas is a program — that is what wasm is
// for), the router demo (it owns its own URL) and the bridge demo (it is the
// point where the two paths meet) — then the code-only coverage of what can't
// run as one.
var ExampleNav = []templates.NavGroup{
	{
		Title: "Compiled markup (x)",
		Items: []templates.NavItem{
			{Label: "Overview", Path: "examples/"},
			{Label: "Counter", Path: "examples/x-counter/"},
			{Label: "Keyed list", Path: "examples/x-todo/"},
			{Label: "Forms & computed", Path: "examples/x-forms/"},
			{Label: "Attribute bindings", Path: "examples/x-bindings/"},
			{Label: "Async data", Path: "examples/x-async/"},
			{Label: "FAQ", Path: "examples/x-faq/"},
			{Label: "Under the hood", Path: "examples/x-under-the-hood/"},
		},
	},
	{
		Title: "WASM demos",
		Items: []templates.NavItem{
			{Label: "Counter", Path: "examples/counter/"},
			{Label: "Keyed list", Path: "examples/list/"},
			{Label: "Form bindings", Path: "examples/forms/"},
			{Label: "Attribute bindings", Path: "examples/bindings/"},
			{Label: "Async data", Path: "examples/async/"},
			{Label: "Canvas", Path: "examples/canvas/"},
			{Label: "Stopwatch", Path: "examples/stopwatch/"},
			{Label: "Filter", Path: "examples/filter/"},
		},
	},
	{
		Title: "In code",
		Items: []templates.NavItem{
			{Label: "Templ basics", Path: "examples/templ-basics/"},
			{
				Label: "Tree & content", Path: "examples/tree-and-content/",
				Sub: []templates.SubItem{
					{Label: "Building the tree", Anchor: "#building-the-tree"},
					{Label: "Markdown collections", Anchor: "#markdown-collections"},
					{Label: "Locales", Anchor: "#locales"},
				},
			},
			{
				Label: "Scripts & routing", Path: "examples/scripts-and-routing/",
				Sub: []templates.SubItem{
					{Label: "Compiling scripts", Anchor: "#compiling-scripts"},
					{Label: "Client-side routing", Anchor: "#client-side-routing"},
				},
			},
			{
				Label: "wasmwrap & templ", Path: "examples/wasmwrap-and-templ/",
				Sub: []templates.SubItem{
					{Label: "wasmwrap without reactive", Anchor: "#wasmwrap-without-reactive"},
					{Label: "Re-rendering templ client-side", Anchor: "#re-rendering-templ-client-side"},
				},
			},
		},
	},
	{
		Title: "Full apps",
		Items: []templates.NavItem{
			{Label: "Router demo", Path: "examples/router-demo/"},
			{Label: "Bridge demo", Path: "examples/bridge/"},
		},
	},
}

// examplePage wraps one example's content in the shared sidebar and pager,
// exactly as DocPage does for docs — see main.go for how prev/next are wired
// from ExampleNav's own order.
templ examplePage(c ssg.Ctx, prev, next *templates.NavItem) {
	@templates.Layout(c, "Examples", ExampleNav, nil) {
		<article class="prose">
			{ children... }
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

templ ExampleOverview(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Examples</h1>
		<p class="lede">
			Working code before explanation, so you can see what the API does and
			then read why it works. Every WASM demo has a compiled-markup twin
			with the same behaviour — the JavaScript generated at build time and
			embedded in the page (view source: no WASM loaded), or full Go in the
			browser when you need it. The last few pages are code-only: templ
			authoring and the parts of astwerk that build a site rather than run in
			one. Starting from nothing instead? The
			<a href={ c.Link("tutorial/") }>Build a site</a> tutorial goes step by
			step from <code>go mod init</code> to a deployed site.
		</p>

		<h2>Compiled markup (x)</h2>
		<div class="cards">
			@templates.Card("Counter", "x.Text", "A signal, a derived double, and +/−/reset handlers — compiled to JavaScript at build time.", c.Link("examples/x-counter/"))
			@templates.Card("Keyed list", "x.List", "Add and remove todos; rows are keyed, so nodes move instead of rebuilding.", c.Link("examples/x-todo/"))
			@templates.Card("Forms & computed", "x.Number", "Two-way number inputs and an x.Computed total, compiled to JavaScript.", c.Link("examples/x-forms/"))
			@templates.Card("Attribute bindings", "x.Attr", "x.Attr, x.Class, x.Disabled and x.Style — each owning one property.", c.Link("examples/x-bindings/"))
			@templates.Card("Async data", "x.Script", "A fake fetch through the script escape hatch: loading, data, reload.", c.Link("examples/x-async/"))
			@templates.Card("FAQ", "x.When", "Answers mount and unmount as x.When toggles — a conditional subtree.", c.Link("examples/x-faq/"))
			@templates.Card("Under the hood", "x.Document", "The exact HTML and script the build emitted for a widget, shown on the page itself.", c.Link("examples/x-under-the-hood/"))
		</div>

		<h2>WASM demos</h2>
		<div class="cards">
			@templates.Card("Counter", "reactive", "The same counter — signal, computed double, three handlers — in Go compiled to WebAssembly.", c.Link("examples/counter/"))
			@templates.Card("Keyed list", "BindList", "Moving nodes instead of rebuilding them, keyed by id.", c.Link("examples/list/"))
			@templates.Card("Form bindings", "BindNumber", "Two-way number inputs and a computed total.", c.Link("examples/forms/"))
			@templates.Card("Attribute bindings", "BindAttr", "BindAttr, BindClass and BindStyle — one property per binding.", c.Link("examples/bindings/"))
			@templates.Card("Async data", "Resource", "A Resource's loading, error and data states, all as signals.", c.Link("examples/async/"))
			@templates.Card("Canvas", "wasmwrap", "A typed 2D context and an animation loop.", c.Link("examples/canvas/"))
			@templates.Card("Stopwatch", "SetInterval", "A timer ticking a signal — time is just another value.", c.Link("examples/stopwatch/"))
			@templates.Card("Filter", "Computed", "A search box deriving a filtered slice, rendered by BindList.", c.Link("examples/filter/"))
		</div>

		<h2>In code</h2>
		<div class="cards">
			@templates.Card("Templ basics", "templ", "Components, children, escaping, if/for — the authoring model every astwerk page is built from.", c.Link("examples/templ-basics/"))
			@templates.Card("Tree & content", "ssg.Node", "ssg.Node, Build, markdown collections and locales.", c.Link("examples/tree-and-content/"))
			@templates.Card("Scripts & routing", "CompileFrom", "CompileFrom and reactive.Router — the router is live in Full apps, in an iframe it owns.", c.Link("examples/scripts-and-routing/"))
			@templates.Card("wasmwrap & templ", "BindTempl", "Raw DOM scripting without reactive, and re-rendering templ client-side.", c.Link("examples/wasmwrap-and-templ/"))
		</div>

		<h2>Full apps</h2>
		<div class="cards">
			@templates.Card("Router demo", "reactive.Router", "A two-view SPA that owns its own iframe — the router live, without hijacking this site's navigation.", c.Link("examples/router-demo/"))
			@templates.Card("Bridge demo", "XNum", "One named signal, two runtimes: an x counter and a WASM counter sharing a cell.", c.Link("examples/bridge/"))
		</div>
	}
}

templ ExampleCounter(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A counter</h1>
		<p class="lede">
			The smallest useful thing: a signal, a derived value, three handlers.
			The markup is static; only the numbers change. This is the
			WebAssembly path — the same counter generated as plain JavaScript is
			<a href={ c.Link("examples/x-counter/") }>Counter, no WASM</a>.
		</p>
		<div class="demo" id="counter">
			<div class="counter-row">
				<button data-dec aria-label="Decrement">&minus;</button>
				<span class="counter-value" data-count>0</span>
				<button data-inc aria-label="Increment">+</button>
				<button data-reset aria-label="Reset">reset</button>
			</div>
			<p class="demo-note">Double: <span data-doubled>0</span></p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", counterStateSrc) {
			<p>
				<code>Num</code> creates the state — one constructor per value
				kind, so a <code>BoolSignal</code> has no <code>Inc</code> and a
				<code>NumSignal</code> has no <code>Toggle</code>: what compiles is
				what is meaningful. <code>Computed</code>
				derives <code>doubled</code> from it — calling <code>count.Get()</code>
				inside the function is what registers the dependency, so it
				recomputes whenever count changes.
			</p>
		}
		@templates.Piece("Hydrating the markup", counterHydrateSrc) {
			<p>
				<code>Hydrate</code> attaches behaviour to markup the page already
				rendered — the demo div above, written by hand. <code>BindText</code>
				takes the signal or memo directly and re-renders its element
				whenever the value changes — no function, no conversion, the
				binding formats the value itself.
			</p>
		}
		@templates.Piece("The buttons", counterHandlersSrc) {
			<p>
				<code>On</code> is <code>el.On</code> plus automatic cleanup inside
				an effect. <code>Inc</code>, <code>Dec</code> and <code>Set</code>
				are the one-word forms for the common cases — add one, subtract one,
				store a value — and each change re-runs both bindings.
			</p>
		}
		@templates.FullSource(counterSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the numbers stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleList(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A keyed list</h1>
		<p class="lede">
			Add and remove todos. Entries are keyed, so existing nodes are moved
			rather than rebuilt. The list survives a reload — WASM has the whole
			stdlib, so persistence is one localStorage call, where the
			<a href={ c.Link("examples/x-todo/") }>compiled-markup twin</a>
			keeps a script instead.
		</p>
		<div class="demo" id="todo">
			<form data-form class="todo-form">
				<input data-new type="text" placeholder="Something to do" aria-label="New item"/>
				<button type="submit" data-add>Add</button>
			</form>
			<div data-list class="todo-list"></div>
			<p class="demo-note"><span data-remaining>2 remaining</span></p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", listStateSrc) {
			<p>
				The model is a slice of items; the DOM is a projection of it.
				<code>draft</code> holds the input while it's being typed.
			</p>
		}
		@templates.Piece("The keyed list", listBindSrc) {
			<p>
				<code>BindList</code> takes the parent, the
				<code>*ListSignal</code> itself, a key function and a render
				function. The key is what makes it patch instead of
				re-render: add a row and only a new <code>&lt;li&gt;</code> is
				created; remove one and only that node is detached. The render
				function runs once per key — its <code>*Row</code> gives it
				per-row state, disposed with the row — so wiring the remove
				handler inside it is safe: it closes over its own row.
			</p>
		}
		@templates.Piece("Adding a todo", listAddSrc) {
			<p>
				The field is two-way bound to <code>draft</code>. Submit — Enter
				works — trims, ignores empty text, appends a new item and clears
				the field. <code>items.Update</code> replaces the slice, and
				<code>BindList</code> diffs the keys and patches the DOM to match.
				Every mutation also writes the items back to localStorage.
			</p>
		}
		@templates.Piece("The count", listCountSrc) {
			<p>
				The remaining count is a text binding over the same slice —
				reading <code>items.Get()</code> re-runs it on every change.
			</p>
		}
		@templates.FullSource(listSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the rows stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleForms(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Two-way form bindings</h1>
		<p class="lede">
			Two number inputs bound two-way, a total derived from them, and a
			checkbox that includes 19% tax in the total. Nothing here talks to the
			DOM directly except the bindings — the compiled-markup version is
			<a href={ c.Link("examples/x-forms/") }>Forms &amp; computed</a>.
		</p>
		<div class="demo" id="form-demo">
			<p>
				<label>Price <input data-price type="number" value="12" aria-label="Price"/></label>
			</p>
			<p>
				<label>Quantity <input data-qty type="number" value="2" aria-label="Quantity"/></label>
			</p>
			<p class="demo-note">Total: <span data-total>24.00</span> <span data-taxed style="display:none">28.56</span></p>
			<p>
				<label><input data-tax type="checkbox"/> include 19% tax</label>
			</p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", formStateSrc) {
			<p>
				Two signals hold the inputs; <code>Computed</code> derives the
				total from them — calling <code>price.Get()</code> inside the
				function is what registers the dependency, so the total recomputes
				whenever either input changes.
			</p>
		}
		@templates.Piece("The inputs", formInputsSrc) {
			<p>
				<code>BindNumber</code> is two-way — typing writes the signal,
				setting the signal writes the field — and input that isn't a number
				is ignored. The totals are text bindings over memos.
			</p>
		}
		@templates.Piece("The checkbox", formCheckboxSrc) {
			<p>
				<code>BindChecked</code> two-way binds a bool, and
				<code>BindShow</code> lets that same signal switch which total is
				visible — nothing is rebuilt. The taxed total is where wasm's real
				<code>if</code> is the honest answer, the compiled-markup twin's
				<code>x.Not</code> memo being its mirror image.
			</p>
		}
		@templates.FullSource(formSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the bindings stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleBindings(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Attribute bindings</h1>
		<p class="lede">
			The WASM twin of the compiled-markup attribute bindings: four
			one-property bindings — <code>href</code>, <code>class</code>,
			<code>disabled</code>, <code>style</code> — each driven by its own
			signal. Change a signal and exactly that property updates, nothing
			else re-renders. The compiled-markup version is
			<a href={ c.Link("examples/x-bindings/") }>Attribute bindings</a>.
		</p>
		<div class="demo" id="bindings-demo">
			<p><a data-bind-href href="https://templ.guide">templ.guide</a></p>
			<p><span data-bind-class>a toggled class</span></p>
			<p><button type="button" data-bind-disabled>save</button></p>
			<p class="demo-note"><span data-bind-status>the save button is enabled</span></p>
			<p><span data-bind-style>styled text</span></p>
			<div class="counter-row">
				<button type="button" data-toggle-class>toggle class</button>
				<button type="button" data-toggle-disabled>toggle disabled</button>
				<button type="button" data-recolour>recolour</button>
				<button type="button" data-retarget>retarget link</button>
			</div>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", bindingsStateSrc) {
			<p>
				One signal per property the demo touches: the link target, the
				class, the disabled flag and the colour.
			</p>
		}
		@templates.Piece("The elements", bindingsElementsSrc) {
			<p>
				Each binding owns one property of one element. <code>BindAttr</code>
				sets a string attribute and removes it when the value is empty;
				<code>BindClass</code> toggles one class; <code>BindStyle</code>
				sets one CSS property.
			</p>
		}
		@templates.Piece("The buttons", bindingsButtonsSrc) {
			<p>
				Each button writes its signal — <code>Toggle</code> flips a bool,
				<code>Set</code> stores a value. The disabled toggle also keeps the
				save button's state visible: a status line bound to a computed
				string, and the toggle's own <code>aria-pressed</code> and
				<code>.on</code> class, both driven by the same signal. Because each
				binding owns its property, changing one signal updates exactly that
				element's property — nothing else re-renders.
			</p>
		}
		@templates.FullSource(bindingsSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the bindings stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleAsync(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Async data</h1>
		<p class="lede">
			A <code>Resource</code> exposes its loading and error states as signals
			alongside the data, so all three bind like anything else. The loader
			runs a real <code>wasmwrap.Fetch</code> of a file this site generated
			at build time — <code>examples/data/posts.json</code> — so nothing
			her is faked.
		</p>
		<div class="demo" id="async-demo">
			<p><button data-reload>Reload</button></p>
			<p class="demo-note" data-status></p>
			<div data-posts class="todo-list"></div>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("The resource", asyncResourceSrc) {
			<p>
				<code>NewResource</code> runs the loader on its own goroutine and
				exposes <code>Data</code>, <code>Err</code> and
				<code>Loading</code> as ordinary signals — you always read the
				result back through <code>Data.Get()</code>. The URL is relative to
				this page, so the same build works from disk, at a localhost root
				and deployed.
			</p>
		}
		@templates.Piece("The status line", asyncStatusSrc) {
			<p>
				All three states bind like anything else — a <code>Computed</code>
				string over the signals renders whichever state is current.
			</p>
		}
		@templates.Piece("The list", asyncListSrc) {
			<p>
				The list renders through <code>BindTempl</code>: a Resource's
				<code>Data</code> is a plain <code>Signal[[]Post]</code> and
				<code>BindList</code> needs a <code>*ListSignal</code>, so the
				whole list re-renders on load — the honest trade-off for a
				display-only chunk. Feed a <code>ListSignal</code> from the loader
				when rows must be keyed.
			</p>
		}
		@templates.Piece("Reload", asyncReloadSrc) {
			<p>
				<code>Reload</code> re-runs the loader. A generation counter
				discards a stale response, so an old, slow load can't overwrite
				newer data.
			</p>
		}
		@templates.FullSource(asyncSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the status stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleCanvas(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Canvas</h1>
		<p class="lede">
			A typed 2D context and an animation loop, with the drawing buffer
			matched to the device pixel ratio so it stays sharp. There is no
			compiled-markup twin for this one: a canvas redraws every frame by
			nature, so there is no declarative core to bind to — a canvas is a
			program, and that is what wasm is for.
		</p>
		<div class="demo" id="canvas-demo">
			<canvas data-canvas width="600" height="200"></canvas>
			<p>
				<button data-toggle>Pause</button>
				<span class="demo-note">Move the pointer over the canvas.</span>
			</p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("The context", canvasContextSrc) {
			<p>
				<code>AsCanvas</code> and <code>Context2D</code> wrap the same
				objects <code>getContext("2d")</code> returns, in Go types.
				<code>FitToDisplay</code> matches the pixel buffer to the CSS size
				times the device pixel ratio — skipping it is why canvas drawings
				look blurry on high-DPI screens.
			</p>
		}
		@templates.Piece("The pointer", canvasPointerSrc) {
			<p>
				Pointer moves write a signal. <code>PosIn</code> gives coordinates
				relative to the canvas, whatever its position on the page.
			</p>
		}
		@templates.Piece("The loop", canvasLoopSrc) {
			<p>
				<code>RequestAnimationFrame</code> reschedules itself, handing the
				frame's delta time to the callback; the returned
				<code>cancel</code> stops the loop. The loop reads the pointer with
				<code>Peek</code>, not <code>Get</code>, because it redraws every
				frame anyway.
			</p>
		}
		<details>
			<summary>Why there is no compiled-markup twin</summary>
			<p>
				The <code>x</code> markers pay off when state drives markup. A
				canvas redraws every frame by nature — there is no declarative core
				to bind to — so this demo lives on the wasm path, where the whole
				stdlib ships with the module.
			</p>
		</details>
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the animation stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleStopwatch(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Stopwatch</h1>
		<p class="lede">
			A running timer ticks an <code>elapsed</code> signal and a text binding
			renders it — the display doesn't know or care that it's a timer.
			Compiled markup has no combinator for "every 100ms"; this is what
			<code>wasmwrap.SetInterval</code> is for, so this demo is
			WebAssembly-only.
		</p>
		<div class="demo" id="stopwatch-demo">
			<p><output data-time>0:00.0</output></p>
			<div class="counter-row">
				<button data-start>Start</button>
				<button data-reset>Reset</button>
			</div>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", stopwatchStateSrc) {
			<p>
				One signal, holding seconds as a float. It starts at zero and nothing
				about it says "timer" — it's a value like any other.
			</p>
		}
		@templates.Piece("The tick", stopwatchTickSrc) {
			<p>
				<code>SetInterval</code> runs the function every 100ms; the returned
				<code>cancel</code> stops it. The tick is the only place that knows
				this demo has anything to do with time.
			</p>
		}
		@templates.Piece("The display", stopwatchDisplaySrc) {
			<p>
				<code>BindText</code> takes the formatted value as a
				<code>Computed</code> string — it re-runs on every tick because it
				reads <code>elapsed.Get()</code>, and the formatting is just a
				function of the value, so it can be as simple or as fancy as you
				like.
			</p>
		}
		@templates.Piece("Start, pause, reset", stopwatchControlsSrc) {
			<p>
				The start button flips between starting and cancelling the interval
				and relabels itself. Reset just writes zero — the display updates on
				its own.
			</p>
		}
		@templates.FullSource(stopwatchSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the time stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleFilter(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Filtering a list</h1>
		<p class="lede">
			A two-way bound search box drives an effect that derives a matching
			slice, and <code>BindList</code> renders whatever it contains. The
			filter itself is plain Go — the documented escape hatch — and the
			DOM diffing is the framework's.
		</p>
		<div class="demo" id="filter-demo">
			<p><input data-query type="search" placeholder="Filter the posts…" aria-label="Filter posts"/></p>
			<p class="demo-note"><strong data-count>5</strong> of 5 posts</p>
			<ul data-results class="todo-list"></ul>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@templates.Piece("State", filterStateSrc) {
			<p>
				The posts are a plain slice — no signals, nothing reactive about
				them. The only state is the search box: <code>BindValue</code> is
				two-way, so typing writes <code>query</code> and setting the signal
				would write the field.
			</p>
		}
		@templates.Piece("The filter", filterComputedSrc) {
			<p>
				<code>BindList</code> takes a <code>*ListSignal</code>, so the
				filter is an <code>Effect</code> that computes the matching slice
				and writes it into one: it re-runs on every keystroke because it
				reads <code>query.Get()</code>, and the list stays keyed — rows are
				moved, not rebuilt. An empty query returns everything, so the
				filter is off by default.
			</p>
		}
		@templates.Piece("The list and count", filterListSrc) {
			<p>
				<code>BindList</code> renders the filtered slice with the same keyed
				patching as the <a href={ c.Link("examples/list/") }>keyed list</a>;
				the count is a text binding over the same slice.
			</p>
		}
		@templates.FullSource(filterSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo/</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the results stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleTreeAndContent(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Tree &amp; content</h1>
		<p class="lede">
			These build a site rather than run in one, so they're real code rather
			than a hydrated widget.
		</p>

		<h2 id="building-the-tree">Building the tree</h2>
		<p>
			<code>ssg.Node</code> and <code>Build</code> are the entire mechanism —
			this is what generates this site. See
			<a href={ c.Link("docs/the-node-tree/") }>The Node tree</a>.
		</p>
		@templates.CodeBlock(treeSrc)
		<details>
			<summary>Why relative URLs</summary>
			<p>
				<code>RelativeURLs</code> makes one build work opened from disk, at
				a localhost root, and under a subpath — <code>BaseURL</code> only
				feeds <code>Ctx.URL</code>, for canonical tags. See
				<a href={ c.Link("docs/ctx/") }>Ctx &amp; URLs</a>.
			</p>
		</details>

		<h2 id="markdown-collections">Markdown collections</h2>
		<p>
			<code>content.LoadDir</code> plus <code>Node.Generate</code> turns a
			directory of markdown into one index page and one page per file, with
			no path arithmetic. See
			<a href={ c.Link("docs/content-and-collections/") }>Content &amp; collections</a>.
		</p>
		@templates.CodeBlock(collectionSrc)

		<h2 id="locales">Locales</h2>
		<p>
			A locale's subtree is derived from the base tree — you list only the
			pages that genuinely differ, and everything else is mirrored with the
			prefix set. See <a href={ c.Link("docs/i18n/") }>Locales &amp; i18n</a>.
		</p>
		@templates.CodeBlock(localeSrc)
	}
}

templ ExampleScriptsAndRouting(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Scripts &amp; routing</h1>

		<h2 id="compiling-scripts">Compiling scripts</h2>
		<p>
			<code>CompileFrom</code> is what turned <code>scripts/demo/</code>
			into the WebAssembly running the demos in this section — no bundler, no
			<code>package.json</code>. See
			<a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp; WebAssembly</a>.
		</p>
		@templates.CodeBlock(scriptsSrc)
		<details>
			<summary>What the build produced</summary>
			<p>
				<code>scripts/demo/</code> became
				<code>build/scripts/demo.wasm</code>, with Go's
				<code>wasm_exec.js</code> copied in beside it — exactly what
				<code>WasmScript</code> loads on the demo pages above.
			</p>
		</details>

		<h2 id="client-side-routing">Client-side routing</h2>
		<p>
			<code>reactive.Router</code> swaps views against the real address bar,
			which is exactly why the demo lives in an iframe rather than inline on
			this page — a path-based router cannot share a URL with the site's own
			navigation. The site builds a tiny standalone page the router owns and
			embeds it: <a href={ c.Link("examples/router-demo/") }>the router,
			live</a>. This site's docs sidebar and pager are plain links, not a
			router; this is the shape a single-page app takes instead. See
			<a href={ c.Link("docs/reactive/") }>reactive</a>.
		</p>
		@templates.CodeBlock(routerSrc)
		<details>
			<summary>Why the router runs in an iframe</summary>
			<p>
				<code>Navigate</code> pushes history entries, and history is per
				document — an iframe has its own. The demo owns its frame's URL, so
				its navigation never touches the site's address bar, and the frame
				reloads into the right view because the routes match the path.
			</p>
		</details>
	}
}

templ ExampleWasmwrapAndTempl(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>wasmwrap &amp; templ</h1>

		<h2 id="wasmwrap-without-reactive">wasmwrap without reactive</h2>
		<p>
			<code>reactive</code> is optional. Every other demo in this section
			uses it, but <code>wasmwrap</code> alone is enough for scripting that
			doesn't need signals — a nav toggle is three lines. See
			<a href={ c.Link("docs/wasmwrap/") }>wasmwrap</a>.
		</p>
		@templates.CodeBlock(wasmwrapSrc)
		<details>
			<summary>Why select { "{" }{ "}" } is there</summary>
			<p>
				When <code>main</code> returns, the WASM instance exits and every
				handler dies with it. <code>select {}</code> blocks forever, keeping
				the module alive for the click handler.
			</p>
		</details>

		<h2 id="re-rendering-templ-client-side">Re-rendering templ client-side</h2>
		<p>
			<code>BindTempl</code> runs a templ component in the browser and
			assigns the result as innerHTML — convenient for a display-only
			fragment, wrong for anything interactive, since everything inside is
			destroyed and rebuilt on every update. See
			<a href={ c.Link("docs/reactive/") }>reactive</a>.
		</p>
		@templates.CodeBlock(bindTemplSrc)
		<details>
			<summary>Why BindTempl loses state</summary>
			<p>
				The component renders to a string, and the string is assigned as
				<code>innerHTML</code> — there is nothing to patch against, so the
				whole subtree is replaced and focus, scroll and selection go with
				the old nodes.
			</p>
		</details>

		<p>
			For layouts, an SEO head and an RSS feed ready to copy in, see
			<a href={ c.Link("docs/starter-templates/") }>Starter templates</a>.
		</p>
	}
}

const counterStateSrc = `count := reactive.Num(0)
doubled := reactive.Computed(func() int { return count.Get() * 2 })`

const counterHydrateSrc = `reactive.Hydrate("#counter", func(root wasmwrap.Element) {
	reactive.BindText(root.Find("[data-count]"), count)
	reactive.BindText(root.Find("[data-doubled]"), doubled)
})`

const counterHandlersSrc = `reactive.On(root.Find("[data-inc]"), "click", func(wasmwrap.Event) {
	count.Inc(1)
})
reactive.On(root.Find("[data-dec]"), "click", func(wasmwrap.Event) {
	count.Dec(1)
})
reactive.On(root.Find("[data-reset]"), "click", func(wasmwrap.Event) {
	count.Set(0)
})`

const counterSrc = `count := reactive.Num(0)
doubled := reactive.Computed(func() int { return count.Get() * 2 })

reactive.Hydrate("#counter", func(root wasmwrap.Element) {
	reactive.BindText(root.Find("[data-count]"), count)
	reactive.BindText(root.Find("[data-doubled]"), doubled)

	reactive.On(root.Find("[data-inc]"), "click", func(wasmwrap.Event) {
		count.Inc(1)
	})
	reactive.On(root.Find("[data-dec]"), "click", func(wasmwrap.Event) {
		count.Dec(1)
	})
	reactive.On(root.Find("[data-reset]"), "click", func(wasmwrap.Event) {
		count.Set(0)
	})
})`

const listStateSrc = `type Item struct {
	ID   string
	Text string
}

items := reactive.List([]Item{
	{ID: "1", Text: "Read the docs"},
	{ID: "2", Text: "Build something"},
})
draft := reactive.Str("")`

const listBindSrc = `reactive.BindList(list, items,
	func(it Item) string { return it.ID },
	func(it Item, row *reactive.Row) wasmwrap.Element {
		el := wasmwrap.Create("li")
		remove := wasmwrap.Create("button").SetText("remove")
		reactive.On(remove, "click", func(wasmwrap.Event) {
			items.Update(func(all []Item) []Item {
				return slices.DeleteFunc(all, func(o Item) bool {
					return o.ID == it.ID
				})
			})
		})
		return el.Append(wasmwrap.Create("span").SetText(it.Text), remove)
	})`

const listAddSrc = `reactive.On(form, "submit", func(e wasmwrap.Event) {
	e.PreventDefault()
	text := strings.TrimSpace(draft.Get())
	if text == "" {
		return
	}
	items.Update(func(all []Item) []Item {
		return append(all, Item{ID: fmt.Sprintf("%d", len(all)+1), Text: text})
	})
	draft.Set("")
})`

const listCountSrc = `reactive.BindText(remaining, reactive.Computed(func() int {
	return len(items.Get())
}))`

const listSrc = `type Item struct {
	ID   string
	Text string
}

items := reactive.List([]Item{
	{ID: "1", Text: "Read the docs"},
	{ID: "2", Text: "Build something"},
})
draft := reactive.Str("")

reactive.Hydrate("#todo", func(root wasmwrap.Element) {
	field := root.Find("[data-new]")
	reactive.BindValue(field, draft)

	reactive.On(root.Find("[data-form]"), "submit", func(e wasmwrap.Event) {
		e.PreventDefault()
		text := strings.TrimSpace(draft.Get())
		if text == "" {
			return
		}
		items.Update(func(all []Item) []Item {
			return append(all, Item{ID: fmt.Sprintf("%d", len(all)+1), Text: text})
		})
		draft.Set("")
	})

	reactive.BindText(root.Find("[data-remaining]"), reactive.Computed(func() int {
		return len(items.Get())
	}))

	reactive.BindList(root.Find("[data-list]"), items,
		func(it Item) string { return it.ID },
		func(it Item, row *reactive.Row) wasmwrap.Element {
			el := wasmwrap.Create("li")
			remove := wasmwrap.Create("button").SetText("remove")
			reactive.On(remove, "click", func(wasmwrap.Event) {
				items.Update(func(all []Item) []Item {
					return slices.DeleteFunc(all, func(o Item) bool {
						return o.ID == it.ID
					})
				})
			})
			return el.Append(wasmwrap.Create("span").SetText(it.Text), remove)
		})
})`

const formStateSrc = `price := reactive.Num(12.0)
qty := reactive.Num(2.0)
total := reactive.Computed(func() float64 { return price.Get() * qty.Get() })
tax := reactive.Bool(false)`

const formInputsSrc = `reactive.BindNumber(root.Find("[data-price]"), price)
reactive.BindNumber(root.Find("[data-qty]"), qty)
reactive.BindText(root.Find("[data-total]"), reactive.Computed(func() string {
	return fmt.Sprintf("%.2f", total.Get())
}))`

const formCheckboxSrc = `reactive.BindChecked(root.Find("[data-tax]"), tax)

// The plain total shows while the box is off, the taxed one while it's on —
// the taxed value is where wasm's real if is the honest answer.
reactive.BindShow(root.Find("[data-total]"), reactive.Computed(func() bool {
	return !tax.Get()
}))
reactive.BindText(root.Find("[data-taxed]"), reactive.Computed(func() string {
	if tax.Get() {
		return fmt.Sprintf("%.2f", total.Get()*1.19)
	}
	return ""
}))
reactive.BindShow(root.Find("[data-taxed]"), tax)`

const formSrc = `price := reactive.Num(12.0)
qty := reactive.Num(2.0)
total := reactive.Computed(func() float64 { return price.Get() * qty.Get() })
tax := reactive.Bool(false)

reactive.Hydrate("#form-demo", func(root wasmwrap.Element) {
	reactive.BindNumber(root.Find("[data-price]"), price)
	reactive.BindNumber(root.Find("[data-qty]"), qty)
	reactive.BindText(root.Find("[data-total]"), reactive.Computed(func() string {
		return fmt.Sprintf("%.2f", total.Get())
	}))

	// The plain total shows while the box is off, the taxed one while it's on.
	reactive.BindShow(root.Find("[data-total]"), reactive.Computed(func() bool {
		return !tax.Get()
	}))
	reactive.BindText(root.Find("[data-taxed]"), reactive.Computed(func() string {
		if tax.Get() {
			return fmt.Sprintf("%.2f", total.Get()*1.19)
		}
		return ""
	}))
	reactive.BindShow(root.Find("[data-taxed]"), tax)
	reactive.BindChecked(root.Find("[data-tax]"), tax)
})`

const bindingsStateSrc = `url := reactive.Str("https://templ.guide")
active := reactive.Bool(true)
busy := reactive.Bool(false)
colour := reactive.Str("#4f7cff")`

const bindingsElementsSrc = `reactive.BindAttr(root.Find("[data-bind-href]"), "href", url)
reactive.BindClass(root.Find("[data-bind-class]"), "on", active)
reactive.BindAttr(root.Find("[data-bind-disabled]"), "disabled", reactive.Computed(func() string {
	if busy.Get() {
		return "disabled"
	}
	return "" // empty removes the attribute
}))
reactive.BindStyle(root.Find("[data-bind-style]"), "color", colour)`

const bindingsButtonsSrc = `reactive.On(root.Find("[data-toggle-class]"), "click", func(wasmwrap.Event) {
	active.Toggle()
})
reactive.On(root.Find("[data-toggle-disabled]"), "click", func(wasmwrap.Event) {
	busy.Toggle()
})
reactive.BindText(root.Find("[data-bind-status]"), reactive.Computed(func() string {
	if busy.Get() {
		return "the save button is disabled"
	}
	return "the save button is enabled"
}))
reactive.BindAttr(root.Find("[data-toggle-disabled]"), "aria-pressed", reactive.Computed(func() string {
	if busy.Get() {
		return "true"
	}
	return "false"
}))
reactive.BindClass(root.Find("[data-toggle-disabled]"), "on", busy)
reactive.On(root.Find("[data-recolour]"), "click", func(wasmwrap.Event) {
	colour.Set("#ff4f7c")
})
reactive.On(root.Find("[data-retarget]"), "click", func(wasmwrap.Event) {
	url.Set("https://pkg.go.dev/github.com/LukasDerBaum42/astwerk")
})`

const bindingsSrc = `url := reactive.Str("https://templ.guide")
active := reactive.Bool(true)
busy := reactive.Bool(false)
colour := reactive.Str("#4f7cff")

reactive.Hydrate("#bindings-demo", func(root wasmwrap.Element) {
	reactive.BindAttr(root.Find("[data-bind-href]"), "href", url)
	reactive.BindClass(root.Find("[data-bind-class]"), "on", active)
	reactive.BindAttr(root.Find("[data-bind-disabled]"), "disabled", reactive.Computed(func() string {
		if busy.Get() {
			return "disabled"
		}
		return ""
	}))
	reactive.BindStyle(root.Find("[data-bind-style]"), "color", colour)

	reactive.On(root.Find("[data-toggle-class]"), "click", func(wasmwrap.Event) {
		active.Toggle()
	})
	reactive.On(root.Find("[data-toggle-disabled]"), "click", func(wasmwrap.Event) {
		busy.Toggle()
	})

	// The disabled state is visible: a status line, and the toggle's own
	// aria-pressed and .on class — all driven by the same signal.
	reactive.BindText(root.Find("[data-bind-status]"), reactive.Computed(func() string {
		if busy.Get() {
			return "the save button is disabled"
		}
		return "the save button is enabled"
	}))
	reactive.BindAttr(root.Find("[data-toggle-disabled]"), "aria-pressed", reactive.Computed(func() string {
		if busy.Get() {
			return "true"
		}
		return "false"
	}))
	reactive.BindClass(root.Find("[data-toggle-disabled]"), "on", busy)

	reactive.On(root.Find("[data-recolour]"), "click", func(wasmwrap.Event) {
		colour.Set("#ff4f7c")
	})
	reactive.On(root.Find("[data-retarget]"), "click", func(wasmwrap.Event) {
		url.Set("https://pkg.go.dev/github.com/LukasDerBaum42/astwerk")
	})
})`

const asyncResourceSrc = `type Post struct {
	ID    string
	Title string
}

posts := reactive.NewResource(func() ([]Post, error) {
	return reactive.FetchJSON[[]Post]("../data/posts.json")
})`

const asyncStatusSrc = `reactive.BindText(status, reactive.Computed(func() string {
	if posts.Loading.Get() {
		return "Loading…"
	}
	if err := posts.Err.Get(); err != nil {
		return "Error: " + err.Error()
	}
	return strconv.Itoa(len(posts.Data.Get())) + " posts loaded"
}))`

const asyncListSrc = `reactive.BindTempl(list, func() templ.Component {
	var b strings.Builder
	for _, p := range posts.Data.Get() {
		b.WriteString("<li>" + templ.EscapeString(p.Title) + "</li>")
	}
	return templ.Raw(b.String())
})

// A Resource's Data is a plain Signal[[]T], and BindList needs a ListSignal —
// so the list re-renders as a unit on load. Feed a ListSignal from the loader
// when rows must be keyed.`

const asyncReloadSrc = `reactive.On(reload, "click", func(wasmwrap.Event) { posts.Reload() })`

const asyncSrc = `type Post struct {
