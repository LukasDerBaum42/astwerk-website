const bindTemplSrc = `reactive.BindTempl(preview, func() templ.Component {
	return views.Markdown(source.Get())
})

// Convenient for a display-only panel that changes as a unit. Wrong for
// anything interactive: templ produces a string, so everything inside
// preview is destroyed and rebuilt — losing focus, scroll and selection.`

templ ExampleRouterDemo(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>The router, live</h1>
		<p class="lede">
			The <code>reactive.Router</code> in its natural habitat: a small
			single-page app that owns its own URL. It lives in an iframe because a
			path-based router cannot share an address bar with this site's own
			navigation — the frame's URL is the demo's to drive. Click a post,
			then use the back button: the views swap inside the frame, and the
			site's own URL never moves.
		</p>
		<div class="demo">
			<iframe
				class="demo-frame"
				src={ c.Link("examples/router/") }
				title="reactive.Router demo"
				loading="lazy"
			></iframe>
		</div>

		<h2>How it works</h2>
		<p>
			The frame is a standalone page the build writes — its own
			<code>&lt;head&gt;</code>, the wasm loader, and a root element. The
			app reads its own path from a build-time <code>data-app-root</code>
			attribute and matches routes relative to it, so the same demo works
			from disk, at a localhost root and deployed. The views are built with
			the wasmwrap widgets; <code>Navigate</code> pushes history entries in
			<i>the frame's</i> history, and <code>InterceptLinks</code> turns the
			post links into client-side navigation.
		</p>
		@templates.Piece("Routing", routerDemoSrc) {
			<p>
				<code>Router</code> renders the view for the current path and swaps
				it on navigation; each view gets its own scope, disposed when you
				navigate away. The current path is a signal — the address-bar line
				inside the frame is a binding over <code>Path()</code>, so it follows
				every navigation, the browser's back and forward buttons included.
			</p>
		}
		@templates.FullSource(routerDemoSrc)
		<p>
			The same page, embedded this way because routing is the one demo that
			cannot live inline — the honest reason is on the
			<a href={ c.Link("examples/scripts-and-routing/") }>Scripts &amp;
			routing</a> page, and the API on
			<a href={ c.Link("docs/reactive-router/") }>routing &amp; async</a>.
		</p>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
}

templ ExampleBridge(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>One state, two runtimes</h1>
		<p class="lede">
			The terminology matrix's proof: <code>x</code> and
			<code>reactive</code> share one state model, and the bridge is the
			door between them. Below, two counters — one compiled markup, one
			WebAssembly — drive the <em>same</em> signal, created on the x side
			as a named cell and mirrored on the WASM side with
			<code>reactive.XNum</code>. Click either one.
		</p>
		<div class="bridge-demo">
			@x.Document(bridgeXDemo(), templates.XOptions()...)
			<div class="bridge-side" id="bridge-wasm">
				<p class="bridge-title">reactive &mdash; WebAssembly</p>
				<div class="counter-row">
					<button type="button" data-bridge-dec aria-label="Decrement">&minus;</button>
					<span class="counter-value" data-bridge-count>0</span>
					<button type="button" data-bridge-inc aria-label="Increment">+</button>
				</div>
			</div>
		</div>
		@templates.WasmScript(c, "bridge_demo")

		<h2>How it works</h2>
		@templates.PieceTempl("The x side", bridgeXStateSrc) {
			<p>
				A <code>NamedNumSignal</code> declares the cell under a fixed name.
				The name is stable API: the build registers it, and any script or
				wasm module can reach it by name.
			</p>
		}
		@templates.Piece("The WASM side", bridgeWasmSrc) {
			<p>
				<code>XNum</code> returns a <code>*NumSignal[int]</code> that is a
				mirror of the x cell: reads come from it, writes go to it, and both
				sides' bindings update live. Equality checks on both sides stop the
				mirror from looping — a write that changes nothing notifies nobody.
			</p>
		}
		@templates.FullSourceTempl(bridgeXFullSrc)
		@templates.FullSource(bridgeWasmFullSrc)
		<p>
			The shared model, row by row, is the
			<a href={ c.Link("docs/which-tool/") }>x &harr; reactive terminology
			matrix</a>.
		</p>
		<noscript>
			<p class="warn">This demo needs WebAssembly for the right side.</p>
		</noscript>
	}
}

// RouterShell is the standalone document the router demo owns: its own head,
// the wasm loader, and a root element the app hydrates. It is deliberately not
// the site layout — the frame's URL belongs to the demo.
templ RouterShell(c ssg.Ctx) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>astwerk router demo</title>
			<link rel="canonical" href={ "https://lukasderbaum42.github.io" + c.URL() }/>
			<link rel="stylesheet" href={ c.Asset("style/style.css") }/>
			<script src={ c.Asset("scripts/wasm_exec.js") }></script>
		</head>
		<body class="router-shell">
			<p class="router-path">Path: <code data-path></code></p>
			<div id="app" data-app-root={ c.Base + "/" + c.Path }></div>
			<script data-wasm={ c.Asset("scripts/router_demo.wasm") }>
				(() => {
					const src = document.currentScript.dataset.wasm;
					const go = new Go();
					WebAssembly.instantiateStreaming(fetch(src), go.importObject)
						.then(res => go.run(res.instance))
						.catch(err => console.error("failed to start " + src, err));
				})();
			</script>
		</body>
	</html>
}

const routerDemoSrc = `//go:build js && wasm

package main

import (
	"strings"

	"github.com/LukasDerBaum42/astwerk-live/reactive"
	"github.com/LukasDerBaum42/astwerk-live/wasmwrap"
)

func main() {
	root := wasmwrap.Query("#app")
	base := strings.TrimSuffix(root.Dataset().Get("app-root"), "/")

	reactive.Router(root, []reactive.Route{
		{Path: base + "/", View: listView(base)},
		{Path: base + "/posts/:slug", View: detailView(base)},
		{Path: base + "/*", View: notFoundView(base)},
	})
	reactive.InterceptLinks(root)

	// The address bar, live: reactive.Path is a signal, so this binding re-runs
	// on every navigation — including the browser's back and forward buttons,
	// which Navigate never sees.
	reactive.BindText(wasmwrap.Query("[data-path]"), reactive.Computed(func() string {
		p := strings.TrimPrefix(reactive.Path(), base)
		if p == "" {
			p = "/"
		}
		return p
	}))

	// Keep the module alive: main returning would tear down every handler.
	select {}
}

// The three views — list, detail and the catch-all — build plain wasmwrap
// widgets; the complete file lives in scripts/router_demo/main.go.`

const bridgeXStateSrc = `var shared = x.NamedNumSignal("shared", 0)

// @shared renders the value; x.On buttons write the cell. The name "shared"
// is stable API — the build registers it for the bridge below.`

const bridgeXFullSrc = `var XShared = x.NamedNumSignal("shared", 0)

// bridgeXDemo is the compiled-markup half of the bridge demo: a counter over
// the shared named cell. The WASM half mirrors the same cell with XNum, so
// clicking either side updates both.
templ bridgeXDemo() {
	<div class="bridge-side" id="bridge-x">
		<p class="bridge-title">x &mdash; compiled markup</p>
		<div class="counter-row">
			@x.El("button", x.On("click", XShared.Dec(1))) {
				&minus;
			}
			<span class="counter-value">@x.Text(XShared)</span>
			@x.El("button", x.On("click", XShared.Inc(1))) {
				+
			}
		</div>
	</div>
}

// On the page: @x.Document(bridgeXDemo(), ...)`

const bridgeWasmSrc = `shared := reactive.XNum[int]("shared")

reactive.BindText(root.Find("[data-bridge-count]"), shared)
reactive.On(root.Find("[data-bridge-dec]"), "click", func(wasmwrap.Event) {
	shared.Dec(1)
})
reactive.On(root.Find("[data-bridge-inc]"), "click", func(wasmwrap.Event) {
	shared.Inc(1)
})

// A mirror of the x cell: reads come from it, writes go to it, and both
// sides' bindings update live.`

const bridgeWasmFullSrc = `//go:build js && wasm

package main

import (
	"github.com/LukasDerBaum42/astwerk-live/reactive"
	"github.com/LukasDerBaum42/astwerk-live/wasmwrap"
)

func main() {
	reactive.Hydrate("#bridge-wasm", func(root wasmwrap.Element) {
		shared := reactive.XNum[int]("shared")

		reactive.BindText(root.Find("[data-bridge-count]"), shared)
		reactive.On(root.Find("[data-bridge-dec]"), "click", func(wasmwrap.Event) {
			shared.Dec(1)
		})
		reactive.On(root.Find("[data-bridge-inc]"), "click", func(wasmwrap.Event) {
			shared.Inc(1)
		})
	})

	// Keep the module alive: main returning would tear down every handler.
	select {}
}`
