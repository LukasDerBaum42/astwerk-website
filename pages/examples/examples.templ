package examples

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// ExampleNav is the sidebar for every page under examples/, in reading order.
// These are core examples: they build or describe a site with ssg, content and
// the build step, not with the optional astwerk-live client packages.
var ExampleNav = []templates.NavGroup{
	{
		Title: "Core examples",
		Items: []templates.NavItem{
			{Label: "Overview", Path: "examples/"},
			{Label: "Templ basics", Path: "examples/templ-basics/"},
			{
				Label: "Tree & content", Path: "examples/tree-and-content/",
				Sub: []templates.SubItem{
					{Label: "Building the tree", Anchor: "#building-the-tree"},
					{Label: "Markdown collections", Anchor: "#markdown-collections"},
					{Label: "Locales", Anchor: "#locales"},
				},
			},
			{
				Label: "Scripts", Path: "examples/scripts/",
				Sub: []templates.SubItem{
					{Label: "Compiling scripts", Anchor: "#compiling-scripts"},
					{Label: "Loading a module", Anchor: "#loading-a-module"},
				},
			},
		},
	},
}

// examplePage wraps one example's content in the shared sidebar and pager,
// exactly as DocPage does for docs — see main.go for how prev/next are wired
// from ExampleNav's own order.
templ examplePage(c ssg.Ctx, prev, next *templates.NavItem) {
	@templates.Layout(c, "Examples", ExampleNav) {
		<article class="prose">
			{ children... }
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

templ ExampleOverview(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Examples</h1>
		<p class="lede">
			Core astwerk is small enough to show in full. These pages cover the
			three things a site is made of: templ components, the node tree with
			markdown content, and the build step that compiles scripts. Everything
			here is plain Go and templ — no client runtime, no WASM.
		</p>
		<div class="cards">
			@templates.Card("Templ basics", "templ", "Components, expressions, children, loops and attributes — the authoring model every astwerk page uses.", c.Link("examples/templ-basics/"))
			@templates.Card("Tree & content", "ssg + content", "A node tree, markdown collections and derived locales: the whole site-building path.", c.Link("examples/tree-and-content/"))
			@templates.Card("Scripts", "CompileFrom", "Compile a Go or TypeScript file as part of the build, then load it with a normal script tag.", c.Link("examples/scripts/"))
		</div>
		<h2>Beyond core</h2>
		<p>
			Client-side helpers — compiled markup, signals, direct DOM access and
			a browser DOM for tests — live in the separate
			<a href="https://github.com/LukasDerBaum42/astwerk-live">astwerk-live</a>
			extension. They are optional and still moving; the
			<a href={ c.Link("docs/which-tool/") }>client-side tools</a> page in the
			docs is the entry point.
		</p>
	}
}

templ ExampleTreeAndContent(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Tree &amp; content</h1>
		<p class="lede">
			These build a site rather than run in one, so they're real code rather
			than a hydrated widget.
		</p>
		<h2 id="building-the-tree">Building the tree</h2>
		<p>
			<code>ssg.Node</code> and <code>Build</code> are the entire mechanism —
			this is what generates this site. See
			<a href={ c.Link("docs/the-node-tree/") }>The Node tree</a>.
		</p>
		@templates.CodeBlock(treeSrc)
		<details>
			<summary>Why relative URLs</summary>
			<p>
				<code>RelativeURLs</code> makes one build work opened from disk, at
				a localhost root, and under a subpath — <code>BaseURL</code> only
				feeds <code>Ctx.URL</code>, for canonical tags. See
				<a href={ c.Link("docs/ctx/") }>Ctx &amp; URLs</a>.
			</p>
		</details>
		<h2 id="markdown-collections">Markdown collections</h2>
		<p>
			<code>content.LoadCollection</code> plus <code>Node.Generate</code>
			turns a directory of markdown into one index page and one page per
			file, with no path arithmetic. See
			<a href={ c.Link("docs/content-and-collections/") }>Content &amp; collections</a>.
		</p>
		@templates.CodeBlock(collectionSrc)
		<h2 id="locales">Locales</h2>
		<p>
			A locale's subtree is derived from the base tree — you list only the
			pages that genuinely differ, and everything else is mirrored with the
			prefix set. See <a href={ c.Link("docs/i18n/") }>Locales &amp; i18n</a>.
		</p>
		@templates.CodeBlock(localeSrc)
	}
}

templ ExampleScripts(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Scripts</h1>
		<p class="lede">
			A node with <code>CompileFrom</code> compiles a scripts directory into
			the output. That is a build feature, not a client runtime: core astwerk
			never ships JavaScript to a page on its own.
		</p>
		<h2 id="compiling-scripts">Compiling scripts</h2>
		<p>
			<code>CompileFrom</code> runs <code>ssg.CompileScripts</code>. A Go
			file with the wasm build constraint becomes a <code>.wasm</code>
			module, a subdirectory with such a file becomes
			<code>NAME.wasm</code>, and <code>.ts</code> files are handed to
			<code>tsc</code> in one batch.
		</p>
		@templates.CodeBlock(scriptsSrc)
		<p>
			See
			<a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp; WebAssembly</a>
			to learn about the build constraints, the produced files and the size
			trade-off.
		</p>
		<h2 id="loading-a-module">Loading a module</h2>
		<p>
			The output is an ordinary file; loading it is an ordinary script tag.
			<code>starter/wasm/wasm_script.templ</code> ships the loader ready to
			copy:
		</p>
		@templates.CodeBlockTempl(wasmLoaderSrc)
		<p>
			For compiled markup, signals or a full client-side runtime, see the
			optional 
			<a href={ c.Link("docs/which-tool/") }>
				astwerk-live
				extensions
			</a>. The note there matters: that side of the project is
			still in heavy redesign.
		</p>
	}
}
