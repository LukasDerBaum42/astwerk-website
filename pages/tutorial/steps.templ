package tutorial

import (
	"encoding/json"
	"fmt"

	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/content"
	x "github.com/LukasDerBaum42/astwerk-live/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

var tutCount = x.NamedNumSignal("count", 0)

// tutLang is the state behind the live language switcher on the locale step.
var tutLang = x.NamedStrSignal("lang", "en")

// tutTreeAbout and tutTreeStyle are the node toggles on the tree step's live
// demo: which nodes are in the tree, reflected in the output tree below. Named
// because the effect script reads them as about.get() and style.get().
var (
	tutTreeAbout = x.NamedBoolSignal("about", false)
	tutTreeStyle = x.NamedBoolSignal("style", false)
)

// tutTag and tutPage drive the tags & pagination demo: which tag is selected
// ("" = all) and which page of the mini collection is showing.
var (
	tutTag  = x.NamedStrSignal("tag", "")
	tutPage = x.NamedNumSignal("page", 1)
)

// tutPost is one row of the step-6 demo's mini collection. The json tags are
// the field names the browser half of the keyed list reads.
type tutPost struct {
	Title string `json:"title"`
	Tags  string `json:"tags"`
}

// tutPosts is the demo's collection, chunked into page groups below the same
// way the step's Go code chunks a real one — the build-time arithmetic the
// step teaches, running in the site itself.
var tutPosts = []tutPost{
	{Title: "Hello, blog", Tags: "meta"},
	{Title: "Signals, not callbacks", Tags: "go"},
	{Title: "Keyed lists", Tags: "go,meta"},
	{Title: "A locale, derived", Tags: "meta"},
	{Title: "WASM is opt-in", Tags: "go"},
	{Title: "The escape hatch", Tags: "go,meta"},
}

// tutPageGroups splits the demo's posts into pages with the same content.Chunk
// the step's code uses. The demo starts on page one: the keyed list's static
// rows are exactly the first group.
var tutPageGroups = content.Chunk(tutPosts, 3)

// tutVisible is the keyed list the demo renders. The effect script computes
// the visible slice (the filter is plain JS — the documented escape hatch)
// and writes it here; x.List patches the DOM, moving rows instead of
// rebuilding them.
var tutVisible = x.NamedListSignal("visible", tutPageGroups[0])

// tutGraphCount drives the dependency-graph demo on the interactivity step.
var tutGraphCount = x.NamedNumSignal("graph", 0)

templ localeDemo() {
	<div class="demo locale-demo">
		<div class="counter-row">
			@x.El("button", x.On("click", tutLang.SetTo("en"))) {
				English
			}
			@x.El("button", x.On("click", tutLang.SetTo("de"))) {
				Deutsch
			}
		</div>
		<p data-en><strong>My Blog</strong> — a blog built with astwerk.</p>
		<p data-de style="display:none"><strong>Mein Blog</strong> — ein Blog, gebaut mit astwerk.</p>
		@x.Effect() {
			<script>
				const en = document.querySelector("[data-en]");
				const de = document.querySelector("[data-de]");
				en.style.display = lang.get() === "en" ? "" : "none";
				de.style.display = lang.get() === "de" ? "" : "none";
				document.querySelectorAll(".locale-demo button").forEach((b, i) => {
					const on = (i === 0 && lang.get() === "en") || (i === 1 && lang.get() === "de");
					b.classList.toggle("on", on);
					b.setAttribute("aria-pressed", String(on));
				});
			</script>
		}
	</div>
}

// treeDemo is the tree step's live version of the tree: the output tree changes
// as you toggle nodes in — the same tree the coming steps build up. With both
// toggles off it shows exactly what the step's build writes.
templ treeDemo() {
	<div class="demo tree-demo">
		<p class="demo-note">The tree is the site — toggle the nodes the next steps add:</p>
		<div class="counter-row">
			@x.El("button", x.On("click", tutTreeAbout.Toggle())) {
				about
			}
			@x.El("button", x.On("click", tutTreeStyle.Toggle())) {
				style
			}
		</div>
		<pre class="tree-output" data-tree-output>build/
└── index.html</pre>
		@x.Effect() {
			<script>
				const render = () => {
					const items = ["index.html"];
					if (about.get()) items.push("about/");
					if (style.get()) items.push("style/");
					const lines = ["build/"];
					items.forEach((it, i) => {
						const last = i === items.length - 1;
						lines.push((last ? "└── " : "├── ") + it);
						if (it === "about/") lines.push((last ? "    " : "│   ") + "└── index.html");
					});
					return lines.join("\n");
				};
				const out = document.querySelector("[data-tree-output]");
				if (out) out.textContent = render();
				document.querySelectorAll(".tree-demo button").forEach((b, i) => {
					const on = i === 0 ? about.get() : style.get();
					b.classList.toggle("on", on);
					b.setAttribute("aria-pressed", String(on));
				});
			</script>
		}
	</div>
}

// tagsDemo is the step-6 widget: a mini collection filtered by tag and paged,
// live. The markers and combinators are the answer — x.Seq resets to page one
// when a tag is picked, and x.List patches the keyed rows — while the script
// only computes the visible slice and paints button states, the documented
// escape hatch for a filter no combinator expresses.
templ tagsDemo() {
	<div class="demo tags-demo">
		<p class="demo-note">Filter by tag — page by page. The same ideas as the Go <code>Filter</code> and <code>Chunk</code> below, live:</p>
		<div class="counter-row tags-filter">
			@x.El("button", x.On("click", x.Seq(tutTag.SetTo(""), tutPage.SetTo(1)))) {
				all
			}
			@x.El("button", x.On("click", x.Seq(tutTag.SetTo("meta"), tutPage.SetTo(1)))) {
				meta
			}
			@x.El("button", x.On("click", x.Seq(tutTag.SetTo("go"), tutPage.SetTo(1)))) {
				go
			}
		</div>
		<div class="tag-posts">
			@x.List(tutVisible, "title", tutPostRow, "postRow")
		</div>
		<div class="counter-row tag-pager">
			for i := range tutPageGroups {
				@x.El("button", x.HtmlAttr("data-pg", fmt.Sprintf("%d", i+1)), x.On("click", tutPage.SetTo(i+1))) {
					{ fmt.Sprintf("%d", i+1) }
				}
			}
		</div>
		@x.Effect(templ.Raw(tagsDemoScript())) { }
	</div>
}

// tutPostRow renders a post present at build time; posts that re-appear after
// filtering are rendered in the browser by the postRow template the script
// defines — one row shape, two renderers, same markup.
templ tutPostRow(p tutPost) {
	<div class="tag-post">
		<strong>{ p.Title }</strong><span>{ p.Tags }</span>
	</div>
}

// tagsDemoScript is the step-6 demo's effect: it reads the tag and page
// signals, computes the visible slice, writes it into the keyed list, and
// paints the button states. The page groups are embedded as a JSON constant —
// the content.Chunk result above, baked into the script at build time.
func tagsDemoScript() string {
	groups, err := json.Marshal(tutPageGroups)
	if err != nil {
		return "<script>/* page groups unavailable */</script>"
	}
	return fmt.Sprintf(`<script>
const groups = %s;
window.postRow = (item) => '<div class="tag-post"><strong>' + item.title + '</strong><span>' + item.tags + '</span></div>';
const sel = tag.get();
const pg = page.get();
const items = groups[pg - 1].filter((p) => sel === "" || p.tags.split(",").includes(sel));
visible.set(items);
document.querySelectorAll(".tags-filter button").forEach((b, i) => {
	const on = (i === 0 && sel === "") || (i === 1 && sel === "meta") || (i === 2 && sel === "go");
	b.classList.toggle("on", on);
	b.setAttribute("aria-pressed", String(on));
});
document.querySelectorAll(".tag-pager button").forEach((b) => {
	const on = b.dataset.pg === String(pg);
	b.classList.toggle("on", on);
	b.setAttribute("aria-pressed", String(on));
});
</script>`, groups)
}

// stepButton is the interactivity step's counter button: a plain templ
// component with no markers of its own, made reactive by x.Wrap — the
// "component you already have" story, binding added around the root element
// without touching the component's markup.
templ stepButton(label string) {
	<button type="button">{ label }</button>
}

// graphDemo is the interactivity step's showpiece: the counter plus a drawing
// of what x generates for it — signal → binding → element — with the path
// lighting up on every change. The graph itself is driven by an x effect.
templ graphDemo() {
	<div class="demo">
		<div class="counter-row">
			@x.Wrap(stepButton("−"), x.On("click", tutGraphCount.Dec(1)))
			<span class="counter-value">@x.Text(tutGraphCount)</span>
			@x.Wrap(stepButton("+"), x.On("click", tutGraphCount.Inc(1)))
		</div>
		<div class="graph" aria-hidden="true">
			<div class="graph-node"><span class="graph-name">graph</span><span class="graph-kind">signal</span></div>
			<div class="graph-edge"></div>
			<div class="graph-node"><span class="graph-name">aw.text</span><span class="graph-kind">binding</span></div>
			<div class="graph-edge"></div>
			<div class="graph-node"><span class="graph-name">&lt;span&gt;</span><span class="graph-kind">element</span></div>
		</div>
		@x.Effect() {
			<script>
				graph.get(); // re-run this effect whenever the signal changes
				document.querySelectorAll(".graph-node").forEach((n) => {
					n.classList.remove("hot");
					void n.offsetWidth;
					n.classList.add("hot");
				});
			</script>
		}
	</div>
}

// checkpoint is a callout listing the files a step should have produced.

templ TutorialOverview(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>Build a site with astwerk</h1>
		<p class="lede">
			Two quest lines, same framework: <strong>Build a blog</strong> goes
			from an empty directory to a two-language blog with tags, RSS and a
			GitHub Pages deployment; <strong>Cookie Clicker</strong> builds a
			live game the other way round — interactivity first, content second.
			Every step is one change, and every snippet here is the whole change for its step.
			You need Go and the templ CLI.
		</p>
		<pre class="install"><code>go install github.com/a-h/templ/cmd/templ@latest</code></pre>
		<p>
			The <code>templ</code> command is the <em>compiler</em> — it turns
			<code>.templ</code> files into Go before <code>go run</code> builds the
			site. It is a separate install from the
			<code>github.com/a-h/templ</code> <em>module</em>, which step 1 adds to
			<code>go.mod</code> as a dependency of your site; installing the module
			does not give you the command. The install above drops the binary in
			<code>$(go env GOPATH)/bin</code> — if <code>templ</code> isn&rsquo;t
			found, add that directory to your <code>PATH</code>:
		</p>
		<pre class="install"><code>export PATH="$PATH:$(go env GOPATH)/bin"</code></pre>

		<h2>Choose your quest</h2>
		<p>
			Every step is a quest: tick objectives and quizzes as you go, and XP
			accrues — visits, checkpoints, quizzes, try-it bonuses and
			completions. Nothing is ever lost and nothing is ever deducted. Your
			progress is saved in your browser, and XP, ranks and badges are
			shared across both lines — the lines are content, not separate games.
		</p>
		@gameMap(c)

		<p>The whole arc, before any code — and the stages light up as the quests behind them complete:</p>
		@overviewPipeline()
		<p>
			The finished site is plain static HTML that deploys anywhere. If you
			would rather copy a starting point than type one, the
			<a href={ c.Link("docs/starter-templates/") }>starter templates</a>
			are this same shape, pre-written.
		</p>

		<h2>Your progress</h2>
		<p>
			The plain lists — what you get without WebAssembly; the game map
			above replaces them once the shell is running. A step counts as done
			when every objective is ticked and every quiz is answered.
		</p>
		<div class="progress overview-progress">
			<div class="progress-bar"><span></span></div>
			<span class="progress-note">0 / { fmt.Sprintf("%d", totalQuests()) } complete</span>
		</div>
		for _, line := range questLines {
			<h4 class="step-line-title">{ line.Name }</h4>
			<ul class="step-list" data-steps={ line.ID }>
				for i, item := range line.Steps {
					<li>
						<input type="checkbox" data-step={ line.ID + "-" + fmt.Sprintf("%d", i+1) } aria-label={ "Mark " + item.Label + " complete" }/>
						<a href={ c.Link(item.Path) }>{ item.Label }</a>
					</li>
				}
			</ul>
		}
		<script>
			(() => {
				const KEY = "astwerk-tutorial-steps";
				const boxes = Array.from(document.querySelectorAll("[data-steps] [data-step]"));
				const bar = document.querySelector(".overview-progress .progress-bar span");
				const note = document.querySelector(".overview-progress .progress-note");
				let done = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));

				const update = () => {
					let n = 0;
					boxes.forEach((b) => {
						const on = done.has(b.dataset.step);
						b.checked = on;
						b.closest("li").classList.toggle("done", on);
						if (on) n++;
					});
					const pct = boxes.length ? Math.round((n / boxes.length) * 100) : 0;
					if (bar) bar.style.width = pct + "%";
					if (note) note.textContent = n + " / " + boxes.length + " complete";
					// The sidebar is gone on tutorial pages; the hub's chain rows take
					// over the done marking — but only without wasm: with the shell
					// alive the save is the single source of truth.
					if (!document.body.classList.contains("shell-alive")) {
						document.querySelectorAll(".sidebar-group a").forEach((a) => {
							const m = (a.getAttribute("href") || "").match(/tutorial\/(?:(\d+)-|clicker\/(\d+)-)/);
							const id = m ? (m[1] ? "blog-" + m[1] : "clicker-" + m[2]) : null;
							a.classList.toggle("done", id ? done.has(id) : false);
						});
						document.querySelectorAll("[data-hub-row]").forEach((a) => {
							a.classList.toggle("done", done.has(a.dataset.hubRow));
						});
					}
				};

				boxes.forEach((b) => {
					b.addEventListener("change", () => {
						if (b.checked) done.add(b.dataset.step);
						else done.delete(b.dataset.step);
						localStorage.setItem(KEY, JSON.stringify(Array.from(done)));
						update();
					});
				});

				update();
			})();
		</script>
	}
}

templ TutorialSetup(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-1", 1) {
			<p>
				A new module — the directory that will become the site:
			</p>
			@terminal(setupInit)
		}
		@questSection("blog-1", 2) {
			<p>
				And its two dependencies: astwerk itself, and the
				<code>github.com/a-h/templ</code> module — the library your pages are
				built on. This is <em>not</em> the templ CLI from the overview: that
				command was installed once with <code>go install</code> (into
				<code>$(go env GOPATH)/bin</code>), while this line only records the
				module in <code>go.mod</code> so <code>templ generate</code> and your
				pages&rsquo; imports resolve.
			</p>
			@terminal(setupDeps)
		}
		@questSection("blog-1", 3) {
			<p>
				That is the entire setup — as long as <code>templ</code> is on your
				<code>PATH</code>, which is the one thing the overview&rsquo;s install
				can&rsquo;t do for you. There is no config file, no project scaffold,
				and no hidden convention scanner — the next step is writing the site.
			</p>
			@projectExplorer(expSetup)
		}
		@checkpoint("go.mod", "go.sum")
	}
}

templ TutorialTree(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-2", 1) {
			<p>
				astwerk's entire build mechanism is one function that walks a tree.
				You describe the output directory as Go values — one
				<code>ssg.Node</code> per directory — and call <code>ssg.Build</code>.
				The tree root is the site root; <code>Page</code> renders its
				<code>index.html</code>.
			</p>
			<p>The tree is the site — here it is live; toggle the nodes the next steps add:</p>
			@x.Document(treeDemo(), templates.XOptions()...)
			@templates.CodeBlock(tutStep2Main)
		}
		@questSection("blog-2", 2) {
			<p>
				<code>ssg.Templ</code> adapts a templ component with the
				<code>(title, path, prefix)</code> signature, and the walker fills
				the values in — so a page never has to be told where it lives. The
				first page, <code>pages/home.templ</code>:
			</p>
			@templates.CodeBlockTempl(tutStep2Home)
		}
		@questSection("blog-2", 3) {
			<p>Generate the Go and build:</p>
			@templates.CodeBlock(buildCmds)
			<p>
				That writes <code>build/index.html</code> — whatever the component
				renders, verbatim. There is no scanner and no config; the tree is
				the site.
			</p>
			@projectExplorer(expTree)
		}
		@checkpoint("main.go", "pages/home.templ")
	}
}

templ TutorialLayout(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-3", 1) {
			<p>
				A real page wants <code>&lt;html&gt;</code>/<code>&lt;head&gt;</code>/
				<code>&lt;body&gt;</code> and a nav — the wrong thing to repeat per
				page. Give the shell its own component that takes children,
				<code>pages/layout.templ</code>. This is the sandwich: the page's own
				content slots into the middle, between the shared parts.
			</p>
			<div class="sandwich" aria-hidden="true">
				<div class="sandwich-block sandwich-head">header — nav, stylesheet</div>
				<div class="sandwich-block sandwich-children">your page&rsquo;s content — <code>&#123; children... &#125;</code></div>
				<div class="sandwich-block sandwich-foot">footer</div>
			</div>
			@templates.CodeBlockTempl(tutLayout)
			<p>
				<code>{ children... }</code> is templ's children mechanism: a caller
				wraps the component instead of passing content in as a parameter.
				Every link goes through <code>prefix</code>, so the same layout
				works in every locale.
			</p>
		}
		@questSection("blog-3", 2) {
			<p>
				The stylesheet is the escape hatch for anything that isn't a page:
				<code>CopyFrom</code> copies a directory into the build as-is. Add
				<code>style/style.css</code> and one node to the tree:
			</p>
			@templates.CodeBlock(tutStyleTree)
		}
		@questSection("blog-3", 3) {
			<p>The home page now wraps it:</p>
			@templates.CodeBlockTempl(tutHome)
			@checkpoint("pages/layout.templ", "style/style.css")
			@tryit("Add a <footer> to the layout and a colour to style.css, then rebuild.", "Every page gains the footer and the colour — build/index.html changes and build/style/style.css appears. The layout is the shell; CopyFrom copies as-is.")
		}
	}
}

templ TutorialPosts(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-4", 1) {
			<p>
				Content lives in markdown. A post is a file with TOML front matter —
				the <code>+++</code> block — and a body the build renders to HTML:
			</p>
			@templates.CodeBlock(tutPostMD)
			<p>That file, through the build, becomes a page:</p>
			@pipelineDiagram([]Stage{
				{Name: "post.md", Sub: "front matter + markdown body"},
				{Name: "goldmark", Sub: "rendered by the build"},
				{Name: "PostPage", Sub: "a templ component"},
				{Name: "posts/hello/index.html", Sub: "the output"},
			})
		}
		@questSection("blog-4", 2) {
			<p>
				The page component takes the rendered HTML and places it — the body
				is trusted markup, because the build produced it from your markdown:
			</p>
			@templates.CodeBlockTempl(tutPostPage)
			<p>
				And the tree gets one entry per post, computed at build time. Here is
				what step 5 will turn into a one-liner — the manual version, so you
				can see the moving parts:
			</p>
			@templates.CodeBlock(tutPostsManual)
			<p>Rebuild and the post is live:</p>
			@browserFrame("posts/hello/") {
				@templ.Raw(samplePostHTML)
			}
			@projectExplorer(expPosts)
			@checkpoint("content/posts/hello.md", "pages/post.templ")
			@tryit("Drop a second markdown file into content/posts/ and rebuild.", "build/posts/ gains a second directory — one page per file, with nothing to update in the tree.")
		}
	}
}

templ TutorialCollection(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-5", 1) {
			<p>
				Step 4's loop — load, decode, sort, generate — is the list-plus-detail
				pattern, and it's the same for every content directory on every site.
				That is exactly the boilerplate the design law says to abstract:
				<code>content.Collection[T]</code>.
			</p>
			@pipelineDiagram([]Stage{
				{Name: "LoadCollection", Sub: "content/posts, sorted by slug"},
				{Name: "Filter / Sort", Sub: "new collections, chainable"},
				{Name: "Nodes", Sub: "one ssg.Node per item"},
				{Name: "Generate", Sub: "the tree's posts subtree"},
			})
			<p><code>main.go</code> — step 4's loop, one call per stage:</p>
			@templates.CodeBlock(tutPostsCollection)
			<details>
				<summary>What Collection does under the hood</summary>
				<p>
					Exactly step 4's loop: <code>LoadDir</code> loads, <code>Decode</code>
					reads each page's front matter into <code>T</code>, <code>Slugs</code>
					keeps the order deterministic, and <code>Nodes</code> is the
					Generate loop you wrote by hand. The primitives stay public —
					reach for them when a site needs to deviate.
				</p>
			</details>
		}
		@questSection("blog-5", 2) {
			<p>
				And the index half — one tile per post, linking to the detail page
				the collection generated:
			</p>
			@templates.CodeBlockTempl(tutPostsIndex)
			<p>
				<code>Nodes</code> returns the same <code>map[string]ssg.Node</code>
				<code>Generate</code> uses, so it composes with hand-written nodes —
				one odd page can still be built by hand and merged in.
			</p>
			@projectExplorer(expCollection)
			@checkpoint("content/posts/", "pages/post.templ")
			@tryit("Add a Draft field to FrontMatter and filter it out with posts.Filter(...).", "Draft posts stop generating pages — one chained call, no loop to edit. Every post from now on is one markdown file.")
		}
	}
}

templ TutorialTags(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-6", 1) {
			<p>
				A blog grows, and the index needs two things: filtering by tag and
				splitting into pages. Both are ordinary Go over the collection —
				no framework concept involved. This is the widget, live, running the
				step's own code: the posts are Go data chunked into page groups with
				the same <code>content.Chunk</code> below, the tag buttons reset to
				page one with <code>x.Seq</code>, and the rows are a keyed
				<code>x.List</code> the effect fills with the visible slice.
			</p>
			@x.Document(tagsDemo(), templates.XOptions()...)
			<p>In the build, a tag page is a filtered collection:</p>
			@templates.CodeBlock(tutTagsFilter)
		}
		@questSection("blog-6", 2) {
			<p>
				And pagination is <code>Chunk</code> — the arithmetic of splitting a
				slice, left alone because every site wants the pages slightly
				differently:
			</p>
			@templates.CodeBlock(tutPagination)
			@checkpoint("content/posts/")
			@tryit("Add a third post with a new tag, then visit its tag page.", "The tag page appears without touching the tree — the filter ran over whatever the directory contains.")
		}
	}
}

templ TutorialRss(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-7", 1) {
			<p>
				A feed and a sitemap are just files. <code>Node.Files</code> writes
				extra files next to a node's <code>index.html</code> — the escape
				hatch for anything that isn't a page. Add two entries to the root
				node:
			</p>
			@templates.CodeBlock(tutRssFiles)
			<p>
				<code>rss()</code> and <code>sitemap()</code> are plain functions
				writing XML — marshalled with <code>encoding/xml</code>, or built
				from the starter's <code>rss_feed.templ</code>. The output tree gains
				two files at the site root:
			</p>
			@projectExplorer(expRss)
			<p>What the feed looks like — the same shape every reader expects:</p>
			@browserFrame("rss.xml") {
				<pre class="xml-sample"><code>&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;rss version=&quot;2.0&quot;&gt;
  &lt;channel&gt;
    &lt;title&gt;My Blog&lt;/title&gt;
    &lt;link&gt;https://example.com/blog/&lt;/link&gt;
    &lt;item&gt;
      &lt;title&gt;Hello, blog&lt;/title&gt;
      &lt;link&gt;https://example.com/blog/posts/hello/&lt;/link&gt;
    &lt;/item&gt;
  &lt;/channel&gt;
&lt;/rss&gt;</code></pre>
			}
		}
		@questSection("blog-7", 2) {
			<p>
				The sitemap works the same way — every page as a <code>&lt;loc&gt;</code>,
				one build-time loop. This site's own <code>sitemap.xml</code> and
				search index are exactly that: files the build wrote.
			</p>
			@checkpoint("rss.xml", "sitemap.xml")
		}
	}
}

templ TutorialLocale(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-8", 1) {
			<p>
				A locale's subtree is derived from the base tree — you never write
				the site twice. One line mounts a German mirror of everything:
			</p>
			@templates.CodeBlock(tutLocale)
			<p>
				The derivation, drawn: the base tree on the left, the mirror on the
				right — same components, <code>prefix</code> set to <code>/de</code>.
				Only the pages that genuinely differ need an <code>Override</code>.
			</p>
			@mappingDiagram(blogTree(), blogDeTree(), "the same tree, derived — you override only what differs")
			<p>
				Rebuild and every page exists under <code>/de/</code> too, rendered
				by the same components with <code>prefix</code> set to
				<code>/de</code> — nav links and <code>&lt;html lang&gt;</code>
				included.
			</p>
		}
		@questSection("blog-8", 2) {
			<p>
				The <code>Override</code> map is for the pages that genuinely differ;
				everything else is mirrored on its own. See
				<a href={ c.Link("docs/i18n/") }>Locales &amp; i18n</a>.
			</p>
			<p>
				This site is the demo: <a href={ c.Link("docs/") }>the /de/ subtree
				you can visit right now</a> is derived, not written twice — and the
				switcher below is the same idea, live, built with the <code>x</code>
				markers from the next step:
			</p>
			@x.Document(localeDemo(), templates.XOptions()...)
			@tryit("Add a second locale — say fr — with one overridden page.", "A French mirror of the whole site appears under /fr/ — pages you didn't override are rendered by the same components with prefix set to /fr.")
		}
	}
}

templ TutorialInteractivity(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-9", 1) {
			<p class="lede">
				Static until now. The <code>x</code> package adds live behaviour
				without WASM: markers are templ components that render the current
				value <em>and</em> generate the JavaScript that keeps it live, in
				the same call. The counter below is running right now — and the
				diagram under it is what the markers generated: a signal, a binding,
				and the element it owns.
			</p>
			@x.Document(graphDemo(), templates.XOptions()...)
			<p><code>pages/home.templ</code>:</p>
			@templates.CodeBlockTempl(tutHomeWithCounter)
			<p>
				<code>x.NamedNumSignal</code> creates the state under a fixed name, so
				scripts can read it; <code>{ "@" }count</code> renders the value and generates
				the binding that keeps it in sync, and <code>x.On</code> does the same for
				the handler — <code>Inc</code> is one word for "add one". The buttons are
				a component you already have — a plain templ <code>button</code> — made
				reactive with <code>x.Wrap</code>, which applies the binding to the
				component's root element without touching its markup.
				<code>x.Document</code> emits the runtime and state declarations before
				its body and the bindings after it. View source on this page: the
				bindings are embedded right here, and no <code>.wasm</code> was
				downloaded. Disable JavaScript and the value still renders — it was
				written statically at build time.
			</p>
			<p>
				The full marker set — bindings, forms, lists, effects — is in
				<a href={ c.Link("docs/x/") }>x — compiled reactive markup</a>.
			</p>
			@tryit("Change the counter's initial value from 0 to 5 and rebuild.", "The button shows 5 before any JavaScript runs — the value is written into the HTML at build time, and the generated script keeps it in sync.")
		}
	}
}

templ TutorialDevloop(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-10", 1) {
			<p>
				<code>go run .</code> is fine once, but you want the build to watch
				and rebuild. The <code>devserver</code> package is that loop. Move
				the tree into a helper so both branches build the same site, and
				add <code>--serve</code>:
			</p>
			@templates.CodeBlock(tutMainServe)
			<p>
				The loop, drawn — each save cycles through the same four steps:
			</p>
			@pipelineDiagram([]Stage{
				{Name: "file changed", Sub: "templ or Go"},
				{Name: "templ generate", Sub: "recompiles .templ"},
				{Name: "go run . --dev", Sub: "rebuilds the site"},
				{Name: "reload", Sub: "the browser refreshes"},
			})
			<p>
				The build runs out of process, because a running Go program cannot
				load new code — editing a <code>.templ</code> recompiles, rebuilds,
				and reloads the browser. A failed build shows its compiler error in
				the browser instead of silently serving the last good output. See
				<a href={ c.Link("docs/dev-server/") }>Dev server</a>.
			</p>
			@terminal(devloopLog)
			@tryit("Edit a .templ file while the dev server runs — then introduce a compile error on purpose.", "Each save rebuilds and reloads the browser; a broken build shows its compiler error as an overlay instead of serving stale output.")
		}
	}
}

templ TutorialShipIt(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		@questSection("blog-11", 1) {
			<p>
				The build directory is the site. Serve it from anywhere — the files
				are plain HTML, CSS and a little JavaScript, with no runtime to
				install.
			</p>
			<p>From this repo to the deployed site:</p>
			@pipelineDiagram([]Stage{
				{Name: "build/", Sub: "what go run . writes"},
				{Name: "upload artifact", Sub: "the workflow's job"},
				{Name: "GitHub Pages", Sub: "served from /repo/"},
			})
			<p>
				One thing worth knowing before deploying: the layout writes
				<code>/style/style.css</code> and <code>/posts/</code> — fine at
				a domain root, wrong under a subpath (GitHub project Pages serve
				from <code>/repo/</code>). If your site will live under a subpath,
				resolve URLs with <code>Ctx.Asset</code>/<code>Ctx.Link</code> and
				build with <code>RelativeURLs: true</code>; the same build then
				works from disk, at a localhost root, and deployed — see
				<a href={ c.Link("docs/the-node-tree/") }>The Node tree</a> and the
				<a href={ c.Link("docs/deploy/") }>deployment recipes</a>.
			</p>
		}
		@questSection("blog-11", 2) {
			<p>
				That's the whole framework: a tree of nodes, pages as templ
				components, collections from markdown, locales derived not written,
				and interactivity compiled at build time. Everything else — the
				router, WASM scripting, SEO head — is documented under the pages on
				the left.
			</p>
			@tryit("Serve the build directory with any static file server — python3 -m http.server, npx serve, whatever you have.", "The site works from any static server: plain HTML, CSS and a little JavaScript, with no runtime to install.")
		}
	}
}

// blogTree and blogDeTree are the trees the locale step's derivation diagram
// draws: the base blog tree and its German mirror.
func blogTree() treeDir {
	return buildExplorer("blog", []string{
		"main.go",
		"pages/layout.templ",
		"pages/home.templ",
		"content/posts/hello.md",
		"style/style.css",
	}, nil)
}

func blogDeTree() treeDir {
	return buildExplorer("de", []string{
		"index.html",
		"posts/hello/index.html",
		"about/index.html",
	}, nil)
}

const setupInit = `mkdir myblog && cd myblog
go mod init example.com/myblog`

const setupDeps = `go get github.com/LukasDerBaum42/astwerk github.com/a-h/templ`

const buildCmds = `templ generate
go run .`

const devloopLog = `$ go run . --serve
2026/08/28 20:00:00 watching build/ …
  [save] pages/home.templ changed
  → templ generate
  → go run . --dev
  ✓ built in 0.42s
  → reloading browser
  [save] content/posts/hello.md changed
  → templ generate
  → go run . --dev
  ✓ built in 0.31s
  → reloading browser`
