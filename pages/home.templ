package pages

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	x "github.com/LukasDerBaum42/astwerk/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

templ Home(c ssg.Ctx) {
	@templates.Layout(c, "", nil) {
		@x.Document(homeBody(c))
	}
}

// homeBody is the whole page. It is wrapped in one x.Document so the hero's
// live tree and the accent picker share a single program — one runtime, one
// set of state declarations, no collisions.
templ homeBody(c ssg.Ctx) {
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Static sites, no magic</p>
			<h1>astwerk</h1>
			<p class="tagline">
				A minimal, no-magic static site generator for Go&nbsp;+&nbsp;templ.
				No Node.js, no JS build tooling. Interactivity via compiled markup —
				or Go&nbsp;&rarr;&nbsp;WASM when you need the whole language.
			</p>
			<pre class="install"><code>go get github.com/LukasDerBaum42/astwerk</code></pre>
			<p class="cta">
				<a class="button" href={ c.Link("tutorial/") }>Build a site</a>
				<a class="button ghost" href={ c.Link("docs/quick-reference/") }>Quick reference</a>
				<a class="button ghost" href={ c.Link("examples/") }>See it running</a>
			</p>
			<ul class="badges">
				<li>Go 1.25+</li>
				<li>No Node.js</li>
				<li>Zero config</li>
				<li>MIT</li>
			</ul>
		</div>
		@heroTree()
	</section>

	<section class="law">
		<h2>Design law</h2>
		<blockquote>
			Abstract only the repeating boilerplate. If a project needs something
			the tree can&rsquo;t express, it falls back to plain Go — never a wall
			it can&rsquo;t get past.
		</blockquote>
	</section>

	<section>
		<h2>The whole mechanism</h2>
		<p>
			You describe the output directory as a tree of <code>Node</code>s and
			call <code>Build</code>. There is no config file, no convention
			scanner, no code generation. That is the entire API surface for
			generating a site.
		</p>
		@templates.CodeBlock(homeExample)
		<p>
			That writes <code>build/index.html</code>,
			<code>build/docs/index.html</code>, copies <code>style/</code> in, and
			compiles <code>scripts/</code> to WebAssembly.
		</p>
	</section>

	<section>
		<h2>What you get</h2>
		<div class="cards">
			@card("The tree walker", "ssg", "One function replaces hand-written page loops and scattered os.MkdirAll calls. Pages get their own path and locale handed to them.", c.Link("docs/the-node-tree/"))
			@card("Markdown content", "content", "TOML front matter decoded into your own struct. Point Generate at a directory and get one page per file.", c.Link("docs/content-and-collections/"))
			@card("Derived locales", "BuildLocales", "A locale subtree is generated from the base tree. You list only the pages that genuinely differ.", c.Link("docs/i18n/"))
			@card("Compiled markup", "x", "Markers generate both the HTML and the JavaScript for a page at build time — no WASM, no framework, and static without JavaScript.", c.Link("docs/x/"))
			@card("Go in the browser", "wasmwrap", "syscall/js made to feel like Go: query, style, events, fetch and canvas, with chainable calls.", c.Link("docs/wasmwrap/"))
			@card("Reactive UI (WASM)", "reactive", "Signals with automatic dependency tracking, fine-grained DOM bindings, keyed lists and a router — the full-Go path.", c.Link("docs/reactive/"))
			@card("Starter templates", "starter", "Seventeen copyable .templ files — layouts, collections, SEO, RSS, and the x widgets. Copied, never imported.", c.Link("docs/starter-templates/"))
		</div>
	</section>

	<section>
		<h2>Not for you if…</h2>
		<ul class="plain">
			<li>You want a config file. Go struct literals are the configuration.</li>
			<li>You want conventions to discover your content. You write the tree.</li>
			<li>You want a virtual DOM. Bindings patch one property at a time.</li>
			<li>You want a themes ecosystem. There is a folder of files you copy and edit.</li>
		</ul>
		<p>
			<a href={ c.Link("docs/comparison/") }>Full comparison against Hugo, Zola, Eleventy and Astro &rarr;</a>
		</p>
	</section>

	<section>
		<h2>Make it yours</h2>
		<p>
			This accent switcher is live, and it is built with astwerk's own
			<a href={ c.Link("docs/x/") }><code>x</code></a> package — the buttons
			are compiled markup, not a hand-written script. Pick a colour and it
			sticks for the rest of the site.
		</p>
		@accentPicker()
	</section>
}

templ card(title string, tag string, body string, href string) {
	<a class="card" href={ href }>
		<h3>{ title } <code>{ tag }</code></h3>
		<p>{ body }</p>
	</a>
}

// heroAbout, heroStyle and heroScripts drive the hero's live tree: which
// nodes are in the tree, reflected in the output below.
var (
	heroAbout   = x.Named("about", true)
	heroStyle   = x.Named("style", true)
	heroScripts = x.Named("scripts", true)
)

// heroTree is the hero's live visual: the tree is the site. Toggle a node and
// the output tree changes — the same x package every page can use, no WASM.
templ heroTree() {
	<div class="hero-window">
		<div class="hero-window-bar">
			<span class="dot dot-r"></span>
			<span class="dot dot-y"></span>
			<span class="dot dot-g"></span>
			<span class="hero-window-title">the tree is the site</span>
		</div>
		<div class="hero-window-body">
			<div class="chips">
				@x.El("button", x.On("click", heroAbout.Set(x.Not(heroAbout)))) {
					about
				}
				@x.El("button", x.On("click", heroStyle.Set(x.Not(heroStyle)))) {
					style
				}
				@x.El("button", x.On("click", heroScripts.Set(x.Not(heroScripts)))) {
					scripts
				}
			</div>
			<pre class="tree-output" data-hero-tree>build/
├── index.html
├── about/
│   └── index.html
├── style/
└── scripts/</pre>
			@x.Effect() {
				<script>
					const render = () => {
						const items = ["index.html"];
						if (about.get()) items.push("about/");
						if (style.get()) items.push("style/");
						if (scripts.get()) items.push("scripts/");
						const lines = ["build/"];
						items.forEach((it, i) => {
							const last = i === items.length - 1;
							lines.push((last ? "└── " : "├── ") + it);
							if (it === "about/") lines.push((last ? "    " : "│   ") + "└── index.html");
						});
						return lines.join("\n");
					};
					const out = document.querySelector("[data-hero-tree]");
					if (out) out.textContent = render();
					document.querySelectorAll(".hero-window .chips button").forEach((b, i) => {
						const on = [about.get(), style.get(), scripts.get()][i];
						b.classList.toggle("on", on);
						b.setAttribute("aria-pressed", String(on));
					});
				</script>
			}
			<p class="hero-window-note">
				Live — compiled markup, no WASM. Toggle a node and the output changes.
			</p>
		</div>
	</div>
}

// homeAccent is the site's chosen accent colour. It is named so the effect
// script below can read it as `accent.get()`; every page that renders
// accentPicker() shares the same build-time state.
var homeAccent = x.Named("accent", "indigo")

// accentPicker is a live widget: each button sets the signal, and the effect
// applies the choice to <html data-accent=…> and persists it. The mapping from
// accent name to CSS variables lives in style/style.css.
templ accentPicker() {
	<div class="accent-picker">
		<span class="accent-label">Accent</span>
		@x.El("button", x.On("click", homeAccent.Set(x.Lit("indigo")))) {
			Indigo
		}
		@x.El("button", x.On("click", homeAccent.Set(x.Lit("emerald")))) {
			Emerald
		}
		@x.El("button", x.On("click", homeAccent.Set(x.Lit("orange")))) {
			Orange
		}
		@x.Effect() {
			<script>
				document.documentElement.dataset.accent = accent.get();
				localStorage.setItem("accent", accent.get());
			</script>
		}
		<script>
			// The runtime above declared the signal; hydrate it from a saved
			// preference once, before the effect registers, so reload keeps
			// the chosen accent instead of the build-time default.
			const saved = document.documentElement.dataset.accent;
			if (saved === "emerald" || saved === "orange") accent.set(saved);
		</script>
	</div>
}

const homeExample = `root := ssg.Node{
	Title: "My Site",
	Page:  ssg.Templ(views.Home),
	Children: map[string]ssg.Node{
		"docs":    {Title: "Docs", Generate: docPages},
		"style":   {CopyFrom: "style"},
		"scripts": {CompileFrom: "scripts"},
	},
}

if err := ssg.Build(root, ssg.BuildOptions{Dev: dev}); err != nil {
	log.Fatal(err)
}`
