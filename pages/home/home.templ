package home

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

templ Home(c ssg.Ctx) {
	@templates.Layout(c, "", nil) {
		@homeBody(c)
		@homeWidgets()
	}
}

// homeBody is the whole page. The few interactive bits — the tree toggles and
// the accent picker — are plain JavaScript, so the page demonstrates that core
// astwerk needs no client runtime to be useful.
templ homeBody(c ssg.Ctx) {
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Go-first static sites</p>
			<h1>astwerk</h1>
			<p class="tagline">
				A static site generator that is just a Go program. Describe the
				output directory as a tree, call <code>Build</code>, get HTML.
				No config, no conventions, no client runtime in core.
			</p>
			<pre class="install"><code>go get github.com/LukasDerBaum42/astwerk</code></pre>
			<p class="cta">
				<a class="button" href={ c.Link("docs/getting-started/") }>Get started</a>
				<a class="button ghost" href={ c.Link("docs/") }>Documentation</a>
				<a class="button ghost" href={ c.Link("examples/") }>Examples</a>
			</p>
			<p class="hero-links">
				<a href={ c.Link("docs/how-astwerk-thinks/") }>How astwerk thinks</a>
				&middot;
				<a href={ c.Link("docs/quick-reference/") }>Quick reference</a>
			</p>
			<ul class="badges">
				<li>Go 1.27+</li>
				<li>No Node.js</li>
				<li>No config</li>
				<li>MIT</li>
			</ul>
		</div>
		@heroTree("the tree is the site", "Toggle a node — plain JavaScript, no client runtime.")
	</section>

	<section class="law">
		<h2>Design law</h2>
		<blockquote>
			Abstract only the repeating boilerplate. If a project needs something
			the tree can&rsquo;t express, it falls back to plain Go — never a wall
			it can&rsquo;t get past.
		</blockquote>
	</section>

	<section>
		<h2>The whole mechanism</h2>
		<p>
			You describe the output directory as a tree of <code>Node</code>s and
			call <code>Build</code>. There is no config file, no convention
			scanner, no code generation. That is the entire API surface for
			generating a site.
		</p>
		@templates.CodeBlock(homeExample)
		<p>
			That writes <code>build/index.html</code>,
			<code>build/docs/index.html</code>, copies <code>style/</code> in, and
			compiles <code>scripts/</code> when a script carries the wasm build
			constraint.
		</p>
	</section>

	<section>
		<h2>Core, in six parts</h2>
		<p>
			Everything below is in the main module. Add what a site needs; ignore
			what it doesn&rsquo;t.
		</p>
		<div class="cards">
			@templates.Card("The node tree", "ssg", "One function replaces hand-written page loops and scattered os.MkdirAll calls. Pages get their own path and locale handed to them.", c.Link("docs/the-node-tree/"))
			@templates.Card("Markdown content", "content", "TOML or JSON front matter decoded into your own struct, with collections and markdown components.", c.Link("docs/content-and-collections/"))
			@templates.Card("Derived locales", "BuildLocales", "A locale subtree is generated from the base tree. You list only the pages that genuinely differ.", c.Link("docs/i18n/"))
			@templates.Card("Asset sidecars", "assets", "Pair a directory of images or media with licence and credit metadata from meta.json or meta.toml.", c.Link("docs/quick-reference/#assets"))
			@templates.Card("Dev server", "devserver", "Watch, rebuild, reload. The loop you leave running while you work, with the build kept out of process.", c.Link("docs/dev-server/"))
			@templates.Card("Starter templates", "starter", "Thirteen copyable .templ files — layouts, collections, SEO, RSS and a wasm host. Copied, never imported.", c.Link("docs/starter-templates/"))
		</div>
	</section>

	<section class="static-by-default">
		<h2>Static by default</h2>
		<p>
			Core astwerk ships no client runtime. A page with no script is HTML and
			CSS — the same output a hand-written site would have. If a site needs
			JavaScript, that is a normal <code>&lt;script&gt;</code> tag or a
			compiled wasm module; both are ordinary files in the tree.
		</p>
		<p>
			The optional client-side packages — compiled markup, signals, direct
			DOM access, a browser DOM for tests — live in the separate
			<a href="https://github.com/LukasDerBaum42/astwerk-live">astwerk-live</a>
			extension. That side is still in heavy redesign and is very likely to
			change or be removed; the
			<a href={ c.Link("docs/which-tool/") }>client-side tools</a> page in the
			docs is the honest entry point.
		</p>
	</section>

	<section>
		<h2>Not for you if…</h2>
		<ul class="plain">
			<li>You want a config file. Go struct literals are the configuration.</li>
			<li>You want conventions to discover your content. You write the tree.</li>
			<li>You want a client-side framework in the box. Core has no client runtime.</li>
			<li>You want a themes ecosystem. There is a folder of files you copy and edit.</li>
		</ul>
		<p>
			<a href={ c.Link("docs/comparison/") }>Full comparison against Hugo, Zola, Eleventy and Astro &rarr;</a>
		</p>
	</section>

	<section>
		<h2>Make it yours</h2>
		<p>
			The accent switcher is plain JavaScript and CSS variables. Pick a
			colour and it sticks for the rest of the site.
		</p>
		@accentPicker("Accent", "your accent")
	</section>
}

// heroTree is the hero's live visual: the tree is the site. Toggle a node and
// the output tree changes. This is a plain script — core astwerk has no client
// runtime to demonstrate.
templ heroTree(title, note string) {
	<div class="hero-window">
		<div class="hero-window-bar">
			<span class="dot dot-r"></span>
			<span class="dot dot-y"></span>
			<span class="dot dot-g"></span>
			<span class="hero-window-title">{ title }</span>
		</div>
		<div class="hero-window-body">
			<div class="chips">
				<button type="button" data-node="about" aria-pressed="true">about</button>
				<button type="button" data-node="style" aria-pressed="true">style</button>
				<button type="button" data-node="scripts" aria-pressed="true">scripts</button>
			</div>
			<pre class="tree-output" data-hero-tree>build/
├── index.html
├── about/
│   └── index.html
├── style/
└── scripts/</pre>
			<p class="hero-window-note">{ note }</p>
		</div>
	</div>
}

// accentPicker is the one appearance control on the page. The buttons carry the
// accent names; homeWidgets wires them to localStorage and <html data-accent>.
templ accentPicker(label, suffix string) {
	<div class="accent-picker">
		<span class="accent-label">{ label }</span>
		<button type="button" data-accent-choice="indigo" aria-pressed="true">Indigo</button>
		<button type="button" data-accent-choice="emerald" aria-pressed="false">Emerald</button>
		<button type="button" data-accent-choice="orange" aria-pressed="false">Orange</button>
		<p class="accent-current">
			<span data-accent-name>indigo</span> — { suffix }
		</p>
	</div>
}

// homeWidgets wires the tree toggles and the accent picker. It is shared by the
// English and German home pages; only the surrounding copy is translated.
templ homeWidgets() {
	<script>
		(() => {
			const state = { about: true, style: true, scripts: true };
			const out = document.querySelector("[data-hero-tree]");
			const chips = Array.from(document.querySelectorAll(".hero-window .chips button"));

			const renderTree = () => {
				if (!out) return;
				const items = ["index.html"];
				if (state.about) items.push("about/");
				if (state.style) items.push("style/");
				if (state.scripts) items.push("scripts/");
				const lines = ["build/"];
				items.forEach((it, i) => {
					const last = i === items.length - 1;
					lines.push((last ? "└── " : "├── ") + it);
					if (it === "about/") lines.push((last ? "    " : "│   ") + "└── index.html");
				});
				out.textContent = lines.join("\n");
			};

			chips.forEach((btn) => {
				btn.addEventListener("click", () => {
					const node = btn.dataset.node;
					state[node] = !state[node];
					btn.classList.toggle("on", state[node]);
					btn.setAttribute("aria-pressed", String(state[node]));
					renderTree();
				});
			});
			renderTree();

			const buttons = Array.from(document.querySelectorAll("[data-accent-choice]"));
			const name = document.querySelector("[data-accent-name]");
			const applyAccent = (accent) => {
				if (accent === "indigo") delete document.documentElement.dataset.accent;
				else document.documentElement.dataset.accent = accent;
				localStorage.setItem("accent", accent);
				buttons.forEach((b) => {
					const on = b.dataset.accentChoice === accent;
					b.classList.toggle("on", on);
					b.setAttribute("aria-pressed", String(on));
				});
				if (name) name.textContent = accent;
			};

			buttons.forEach((btn) => {
				btn.addEventListener("click", () => applyAccent(btn.dataset.accentChoice));
			});
			const saved = localStorage.getItem("accent");
			applyAccent(["indigo", "emerald", "orange"].includes(saved) ? saved : "indigo");
		})();
	</script>
}

const homeExample = `root := ssg.Node{
	Title: "My Site",
	Page:  ssg.Templ(views.Home),
	Children: map[string]ssg.Node{
		"docs":    {Title: "Docs", Generate: docPages},
		"style":   {CopyFrom: "style"},
		"scripts": {CompileFrom: "scripts"},
	},
}

if err := ssg.Build(root, ssg.BuildOptions{Dev: dev}); err != nil {
	log.Fatal(err)
}`
