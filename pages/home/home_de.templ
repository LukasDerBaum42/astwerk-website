package home

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// HomeDE is the German home page, mounted under /de/ by the German locale's
// override. It is the same page as Home, translated — the tree demo and the
// accent picker are shared, because the behaviour does not change with the
// language.
templ HomeDE(c ssg.Ctx) {
	@templates.Layout(c, "", nil) {
		@homeBodyDE(c)
		@homeWidgets()
	}
}

templ homeBodyDE(c ssg.Ctx) {
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Statische Seiten, Go-first</p>
			<h1>astwerk</h1>
			<p class="tagline">
				Ein Static-Site-Generator, der einfach ein Go-Programm ist.
				Beschreibe das Ausgabeverzeichnis als Baum, rufe
				<code>Build</code> auf, bekomme HTML. Keine Konfiguration, keine
				Konventionen, keine Client-Laufzeit im Kern.
			</p>
			<pre class="install"><code>go get github.com/LukasDerBaum42/astwerk</code></pre>
			<p class="cta">
				<a class="button" href={ c.Link("docs/getting-started/") }>Loslegen</a>
				<a class="button ghost" href={ c.Link("docs/") }>Dokumentation</a>
				<a class="button ghost" href={ c.Link("examples/") }>Beispiele</a>
			</p>
			<p class="hero-links">
				<a href={ c.Link("docs/how-astwerk-thinks/") }>Wie astwerk denkt</a>
				&middot;
				<a href={ c.Link("docs/quick-reference/") }>Kurzreferenz</a>
			</p>
			<ul class="badges">
				<li>Go 1.27+</li>
				<li>Kein Node.js</li>
				<li>Keine Konfiguration</li>
				<li>MIT</li>
			</ul>
		</div>
		@heroTree("der Baum ist die Seite", "Schalte einen Knoten um — reines JavaScript, keine Client-Laufzeit.")
	</section>

	<section class="law">
		<h2>Design-Gesetz</h2>
		<blockquote>
			Abstrahiere nur den sich wiederholenden Boilerplate. Wenn ein Projekt
			etwas braucht, das der Baum nicht ausdrücken kann, fällt es auf reines
			Go zurück — niemals eine Wand, an der es nicht vorbeikommt.
		</blockquote>
	</section>

	<section>
		<h2>Der ganze Mechanismus</h2>
		<p>
			Du beschreibst das Ausgabeverzeichnis als einen Baum aus
			<code>Node</code>s und rufst <code>Build</code> auf. Es gibt keine
			Konfigurationsdatei, keinen Konventions-Scanner, keine
			Codegenerierung. Das ist die gesamte API-Oberfläche zum Generieren
			einer Seite.
		</p>
		@templates.CodeBlock(homeExample)
		<p>
			Das schreibt <code>build/index.html</code>,
			<code>build/docs/index.html</code>, kopiert <code>style/</code> hinein
			und kompiliert <code>scripts/</code>, wenn ein Skript die
			wasm-Build-Constraint trägt.
		</p>
	</section>

	<section>
		<h2>Der Kern in sechs Teilen</h2>
		<p>
			Alles hier ist im Hauptmodul. Nimm, was eine Seite braucht; ignoriere
			den Rest.
		</p>
		<div class="cards">
			@templates.Card("Der Node-Baum", "ssg", "Eine Funktion ersetzt handgeschriebene Seiten-Schleifen und verstreute os.MkdirAll-Aufrufe. Jede Seite bekommt Pfad und Locale.", c.Link("docs/the-node-tree/"))
			@templates.Card("Markdown-Inhalte", "content", "TOML- oder JSON-Front-Matter in deine eigene Struct dekodiert, mit Collections und Markdown-Komponenten.", c.Link("docs/content-and-collections/"))
			@templates.Card("Abgeleitete Locales", "BuildLocales", "Ein Locale-Teilbaum wird aus dem Basisbaum erzeugt. Du listest nur die Seiten, die sich wirklich unterscheiden.", c.Link("docs/i18n/"))
			@templates.Card("Asset-Sidecars", "assets", "Verknüpfe ein Verzeichnis voller Bilder oder Medien mit Lizenz- und Credit-Metadaten aus meta.json oder meta.toml.", c.Link("docs/quick-reference/#assets"))
			@templates.Card("Dev-Server", "devserver", "Beobachten, neu bauen, neu laden. Die Schleife, die beim Arbeiten läuft — der Build bleibt außerhalb des Prozesses.", c.Link("docs/dev-server/"))
			@templates.Card("Starter-Templates", "starter", "Dreizehn kopierbare .templ-Dateien — Layouts, Collections, SEO, RSS und ein wasm-Host. Kopiert, nie importiert.", c.Link("docs/starter-templates/"))
		</div>
	</section>

	<section class="static-by-default">
		<h2>Statisch als Standard</h2>
		<p>
			Der Kern von astwerk liefert keine Client-Laufzeit. Eine Seite ohne
			Skript ist HTML und CSS — dieselbe Ausgabe wie eine handgeschriebene
			Seite. Wenn eine Seite JavaScript braucht, ist das ein normales
			<code>&lt;script&gt;</code>-Tag oder ein kompiliertes wasm-Modul;
			beides sind gewöhnliche Dateien im Baum.
		</p>
		<p>
			Die optionalen Client-Pakete — kompiliertes Markup, Signale, direkter
			DOM-Zugriff, ein Browser-DOM für Tests — leben im separaten
			<a href="https://github.com/LukasDerBaum42/astwerk-live">astwerk-live</a>-Projekt.
			Diese Seite wird gerade stark umgebaut und wird sich sehr
			wahrscheinlich ändern oder verschwinden; die Seite
			<a href={ c.Link("docs/which-tool/") }>Client-Werkzeuge</a> in der
			Dokumentation ist der ehrliche Einstieg.
		</p>
	</section>

	<section>
		<h2>Nichts für dich, wenn…</h2>
		<ul class="plain">
			<li>Du eine Konfigurationsdatei willst. Go-Struct-Literale sind die Konfiguration.</li>
			<li>Du Konventionen willst, die deine Inhalte finden. Du schreibst den Baum.</li>
			<li>Du ein Client-Framework im Paket willst. Der Kern hat keine Client-Laufzeit.</li>
			<li>Du ein Theme-Ökosystem willst. Es gibt einen Ordner mit Dateien zum Kopieren und Bearbeiten.</li>
		</ul>
		<p>
			<a href={ c.Link("docs/comparison/") }>Vollständiger Vergleich mit Hugo, Zola, Eleventy und Astro &rarr;</a>
		</p>
	</section>

	<section>
		<h2>Mach es zu deinem</h2>
		<p>
			Der Akzent-Umschalter ist reines JavaScript und CSS-Variablen. Wähle
			eine Farbe, und sie bleibt für den Rest der Seite.
		</p>
		@accentPicker("Akzent", "dein Akzent")
	</section>
}
