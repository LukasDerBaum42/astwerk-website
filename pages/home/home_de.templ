package home

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	x "github.com/LukasDerBaum42/astwerk-live/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// HomeDE is the German home page, mounted under /de/ by the German locale's
// override. It is the same page as Home, translated — the accent switcher and
// the hero's live tree are shared components, because the demo itself doesn't
// change with the language.
templ HomeDE(c ssg.Ctx) {
	@templates.Layout(c, "", nil, nil) {
		@x.Document(homeBodyDE(c), templates.XOptions()...)
	}
}

templ homeBodyDE(c ssg.Ctx) {
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Statische Seiten, keine Magie</p>
			<h1>astwerk</h1>
			<p class="tagline">
				Ein Go-first Static-Web-Framework mit optionaler Client-Laufzeit.
				Standardmäßig reines HTML; winziges kompiliertes JavaScript, wenn du
				ein bisschen Interaktivität brauchst; volles Go&nbsp;&rarr;&nbsp;WASM,
				wenn du die ganze Sprache brauchst. Kein Node, keine Konfiguration,
				keine Magie.
			</p>
			<pre class="install"><code>go get github.com/LukasDerBaum42/astwerk</code></pre>
			<p class="cta">
				<a class="button" href={ c.Link("tutorial/") }>Eine Seite bauen</a>
				<a class="button ghost" href={ c.Link("docs/") }>Dokumentation</a>
				<a class="button ghost" href={ c.Link("examples/") }>In Aktion sehen</a>
			</p>
			<p class="hero-links">
				<a href={ c.Link("docs/how-astwerk-thinks/") }>Wie astwerk denkt</a>
				&middot;
				<a href={ c.Link("docs/which-tool/") }>Welches Werkzeug brauche ich?</a>
			</p>
			<ul class="badges">
				<li>Go 1.27+</li>
				<li>Kein Node.js</li>
				<li>Null Konfiguration</li>
				<li>MIT</li>
			</ul>
		</div>
		@heroTree()
	</section>

	<section class="law">
		<h2>Design-Gesetz</h2>
		<blockquote>
			Abstrahiere nur den sich wiederholenden Boilerplate. Wenn ein Projekt
			etwas braucht, das der Baum nicht ausdrücken kann, fällt es auf reines
			Go zurück — niemals eine Wand, an der es nicht vorbeikommt.
		</blockquote>
	</section>

	<section>
		<h2>Der ganze Mechanismus</h2>
		<p>
			Du beschreibst das Ausgabeverzeichnis als einen Baum aus
			<code>Node</code>s und rufst <code>Build</code> auf. Es gibt keine
			Konfigurationsdatei, keinen Konventions-Scanner, keine
			Codegenerierung. Das ist die gesamte API-Oberfläche zum Generieren
			einer Seite.
		</p>
		@templates.CodeBlock(homeExample)
		<p>
			Das schreibt <code>build/index.html</code>,
			<code>build/docs/index.html</code>, kopiert <code>style/</code> hinein
			und kompiliert <code>scripts/</code> zu WebAssembly.
		</p>
	</section>

	<section>
		<h2>Was du bekommst</h2>
		<p>
			Alles hier ist optional und kombinierbar — starte mit dem
			Baum-Walker und füge hinzu, was die Seite braucht. Du weißt nicht,
			wohin eine Funktion gehört?
			<a href={ c.Link("docs/which-tool/") }>Welches Werkzeug brauche ich?</a>
			ist die Entscheidungstabelle.
		</p>
		<div class="cards">
			@templates.Card("Der Baum-Walker", "ssg", "Eine Funktion ersetzt handgeschriebene Seiten-Schleifen und verstreute os.MkdirAll-Aufrufe. Seiten bekommen ihren Pfad und ihre Locale überreicht.", c.Link("docs/the-node-tree/"))
			@templates.Card("Markdown-Inhalte", "content", "TOML-Frontmatter, dekodiert in deinen eigenen Struct. Zeige Generate auf ein Verzeichnis und erhalte eine Seite pro Datei.", c.Link("docs/content-and-collections/"))
			@templates.Card("Abgeleitete Locales", "BuildLocales", "Ein Locale-Unterbaum wird aus dem Basisbaum generiert. Du listest nur die Seiten, die wirklich anders sind.", c.Link("docs/i18n/"))
			@templates.Card("Kompiliertes Markup", "x", "Marker erzeugen das HTML und das JavaScript für eine Seite zur Buildzeit — kein WASM, kein Framework, und statisch ohne JavaScript.", c.Link("docs/x/"))
			@templates.Card("Go im Browser", "wasmwrap", "syscall/js, das sich wie Go anfühlt: query, style, events, fetch und canvas, mit verkettbaren Aufrufen.", c.Link("docs/wasmwrap/"))
			@templates.Card("Reaktive UI (WASM)", "reactive", "Signale mit automatischer Abhängigkeitsverfolgung, feingranulare DOM-Bindings, keyed lists und ein Router — der volle Go-Weg.", c.Link("docs/reactive/"))
			@templates.Card("Starter-Vorlagen", "starter", "Siebzehn kopierbare .templ-Dateien — Layouts, Collections, SEO, RSS und die x-Widgets. Kopiert, nie importiert.", c.Link("docs/starter-templates/"))
		</div>
	</section>

	<section>
		<h2>Nicht für dich, wenn…</h2>
		<ul class="plain">
			<li>Du eine Konfigurationsdatei willst. Go-Struct-Literale sind die Konfiguration.</li>
			<li>Du Konventionen willst, die deine Inhalte entdecken. Du schreibst den Baum.</li>
			<li>Du ein virtuelles DOM willst. Bindings patchen jeweils eine Eigenschaft.</li>
			<li>Du ein Themes-Ökosystem willst. Es gibt einen Ordner mit Dateien, die du kopierst und bearbeitest.</li>
		</ul>
		<p>
			<a href={ c.Link("docs/comparison/") }>Vollständiger Vergleich mit Hugo, Zola, Eleventy und Astro &rarr;</a>
		</p>
	</section>

	<section>
		<h2>Mach es zu deinem</h2>
		<p>
			Dieser Akzent-Umschalter ist live und mit astwerks eigenem
			<a href={ c.Link("docs/x/") }><code>x</code></a>-Paket gebaut — die
			Buttons sind kompiliertes Markup, kein handgeschriebenes Skript. Wähle
			eine Farbe; sie bleibt für den Rest der Seite erhalten.
		</p>
		@accentPicker()
	</section>
}
