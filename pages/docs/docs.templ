package docs

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// DocPage renders one documentation page.
//
// body is HTML rendered at build time from markdown, so it goes through
// templ.Raw rather than being escaped.
templ DocPage(c ssg.Ctx, sidebar []templates.NavGroup, description string, body string, extension bool, prev, next *templates.NavItem) {
	@templates.Layout(c, sidebarTitle(c), sidebar) {
		<article class="prose">
			if extension {
				<p class="extension-note">
					<b>Extension.</b> This page covers <code>astwerk-live</code>, not
					core astwerk. The package is optional, under heavy redesign, and
					very likely to change or be removed.
				</p>
			}
			<h1>{ c.Title }</h1>
			if description != "" {
				<p class="lede">{ description }</p>
			}
			@templ.Raw(body)
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

// DocsIndex lists every documentation page as a card, with its summary.
templ DocsIndex(c ssg.Ctx, sidebar []templates.NavGroup, entries []DocSummary) {
	@templates.Layout(c, sidebarTitle(c), sidebar) {
		<article class="prose">
			<h1>{ sidebarTitle(c) }</h1>
			<p class="lede">
				astwerk is a Go-first static site generator. Start with
				<a href={ c.Link("docs/how-astwerk-thinks/") }>How astwerk thinks</a>
				— the whole architecture on one page — then
				<a href={ c.Link("docs/getting-started/") }>Getting started</a> to
				build your first site. The
				<a href={ c.Link("docs/quick-reference/") }>Quick reference</a> is
				the core API on one page.
			</p>
			<p>
				The last group is different: those pages document optional
				<code>astwerk-live</code> extensions, are still under heavy redesign,
				and are very likely to change or be removed.
			</p>
			<div class="cards">
				for _, e := range entries {
					@docCard(e.Title, e.Description, c.Link(e.Path), e.Extension)
				}
			</div>
		</article>
	}
}

// docCard is one entry in the docs index.
templ docCard(title string, body string, href string, extension bool) {
	<a class="card" href={ href }>
		<h3>
			{ title }
			if extension {
				<span class="card-tag">extension</span>
			}
		</h3>
		<p>{ body }</p>
	</a>
}

// sidebarTitle is the sidebar's heading — locale-aware, because the shell is
// translated even where the page content still falls back to English.
func sidebarTitle(c ssg.Ctx) string {
	if c.Locale == "de" {
		return "Dokumentation"
	}
	return "Documentation"
}

// DocSummary is one entry in the docs index.
type DocSummary struct {
	Title       string
	Description string
	Path        string
	Extension   bool
}

templ NotFound(c ssg.Ctx) {
	@templates.Layout(c, "", nil) {
		<article class="prose">
			<h1>404</h1>
			<p>That page doesn't exist.</p>
			<p><a href={ c.Link("") }>Back to the home page</a></p>
		</article>
	}
}
