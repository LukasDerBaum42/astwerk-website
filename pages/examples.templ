package pages

import (
	"github.com/LukasDerBaum42/astwerk-website/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// ExampleNav is the sidebar for every page under examples/, in reading order:
// the compiled-markup demos first (the recommended path), then the WASM demos —
// each WASM demo has a compiled-markup twin with the same behaviour, so the two
// implementations can be compared feature for feature — then the code-only
// coverage of what can't run as one.
var ExampleNav = []templates.NavGroup{
	{
		Title: "Compiled markup (x)",
		Items: []templates.NavItem{
			{Label: "Overview", Path: "examples/"},
			{Label: "Counter", Path: "examples/x-counter/"},
			{Label: "Keyed list", Path: "examples/x-todo/"},
			{Label: "Forms & computed", Path: "examples/x-forms/"},
			{Label: "Attribute bindings", Path: "examples/x-bindings/"},
			{Label: "Async data", Path: "examples/x-async/"},
			{Label: "Canvas", Path: "examples/x-canvas/"},
			{Label: "FAQ", Path: "examples/x-faq/"},
			{Label: "Under the hood", Path: "examples/x-under-the-hood/"},
		},
	},
	{
		Title: "WASM demos",
		Items: []templates.NavItem{
			{Label: "Counter", Path: "examples/counter/"},
			{Label: "Keyed list", Path: "examples/list/"},
			{Label: "Form bindings", Path: "examples/forms/"},
			{Label: "Attribute bindings", Path: "examples/bindings/"},
			{Label: "Async data", Path: "examples/async/"},
			{Label: "Canvas", Path: "examples/canvas/"},
			{Label: "Stopwatch", Path: "examples/stopwatch/"},
			{Label: "Filter", Path: "examples/filter/"},
		},
	},
	{
		Title: "In code",
		Items: []templates.NavItem{
			{Label: "Templ basics", Path: "examples/templ-basics/"},
			{
				Label: "Tree & content", Path: "examples/tree-and-content/",
				Sub: []templates.SubItem{
					{Label: "Building the tree", Anchor: "#building-the-tree"},
					{Label: "Markdown collections", Anchor: "#markdown-collections"},
					{Label: "Locales", Anchor: "#locales"},
				},
			},
			{
				Label: "Scripts & routing", Path: "examples/scripts-and-routing/",
				Sub: []templates.SubItem{
					{Label: "Compiling scripts", Anchor: "#compiling-scripts"},
					{Label: "Client-side routing", Anchor: "#client-side-routing"},
				},
			},
			{
				Label: "wasmwrap & templ", Path: "examples/wasmwrap-and-templ/",
				Sub: []templates.SubItem{
					{Label: "wasmwrap without reactive", Anchor: "#wasmwrap-without-reactive"},
					{Label: "Re-rendering templ client-side", Anchor: "#re-rendering-templ-client-side"},
				},
			},
		},
	},
}

// examplePage wraps one example's content in the shared sidebar and pager,
// exactly as DocPage does for docs — see main.go for how prev/next are wired
// from ExampleNav's own order.
templ examplePage(c ssg.Ctx, prev, next *templates.NavItem) {
	@templates.Layout(c, "Examples", ExampleNav) {
		<article class="prose">
			{ children... }
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

// piece is one step of an example walkthrough: a heading, its snippet, and
// the explanation as children — "here's the code, here's what it does".
templ piece(title string, src string) {
	<h3>{ title }</h3>
	@templates.CodeBlock(src)
	{ children... }
}

// pieceTempl is piece with templ highlighting, for the compiled-markup demos.
templ pieceTempl(title string, src string) {
	<h3>{ title }</h3>
	@templates.CodeBlockTempl(src)
	{ children... }
}

// fullSource hides the complete copyable file behind a collapsible — the
// walkthrough above shows the parts, this is the whole thing.
templ fullSource(src string) {
	<details>
		<summary>Full source</summary>
		@templates.CodeBlock(src)
	</details>
}

// fullSourceTempl is fullSource with templ highlighting.
templ fullSourceTempl(src string) {
	<details>
		<summary>Full source</summary>
		@templates.CodeBlockTempl(src)
	</details>
}

templ ExampleOverview(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Examples</h1>
		<p class="lede">
			Working code before explanation, so you can see what the API does and
			then read why it works. Every WASM demo has a compiled-markup twin
			with the same behaviour — the JavaScript generated at build time and
			embedded in the page (view source: no WASM loaded), or full Go in the
			browser when you need it. The last few pages are code-only: templ
			authoring and the parts of astwerk that build a site rather than run in
			one. Starting from nothing instead? The
			<a href={ c.Link("tutorial/") }>Build a site</a> tutorial goes step by
			step from <code>go mod init</code> to a deployed site.
		</p>

		<h2>Compiled markup (x)</h2>
		<div class="cards">
			@card("Counter", "x.Text", "A signal, a derived double, and +/−/reset handlers — compiled to JavaScript at build time.", c.Link("examples/x-counter/"))
			@card("Keyed list", "x.List", "Add and remove todos; rows are keyed, so nodes move instead of rebuilding.", c.Link("examples/x-todo/"))
			@card("Forms & computed", "x.Number", "Two-way number inputs and an x.Computed total, compiled to JavaScript.", c.Link("examples/x-forms/"))
			@card("Attribute bindings", "x.Attr", "x.Attr, x.Class, x.Disabled and x.Style — each owning one property.", c.Link("examples/x-bindings/"))
			@card("Async data", "x.Script", "A fake fetch through the script escape hatch: loading, data, reload.", c.Link("examples/x-async/"))
			@card("Canvas", "x.Script", "A canvas animation where the escape hatch is the whole answer.", c.Link("examples/x-canvas/"))
			@card("FAQ", "x.When", "Answers mount and unmount as x.When toggles — a conditional subtree.", c.Link("examples/x-faq/"))
			@card("Under the hood", "x.Document", "The exact HTML and script the build emitted for a widget, shown on the page itself.", c.Link("examples/x-under-the-hood/"))
		</div>

		<h2>WASM demos</h2>
		<div class="cards">
			@card("Counter", "reactive", "The same counter — signal, computed double, three handlers — in Go compiled to WebAssembly.", c.Link("examples/counter/"))
			@card("Keyed list", "BindList", "Moving nodes instead of rebuilding them, keyed by id.", c.Link("examples/list/"))
			@card("Form bindings", "BindNumber", "Two-way number inputs and a computed total.", c.Link("examples/forms/"))
			@card("Attribute bindings", "BindAttr", "BindAttr, BindClass and BindStyle — one property per binding.", c.Link("examples/bindings/"))
			@card("Async data", "Resource", "A Resource's loading, error and data states, all as signals.", c.Link("examples/async/"))
			@card("Canvas", "wasmwrap", "A typed 2D context and an animation loop.", c.Link("examples/canvas/"))
			@card("Stopwatch", "SetInterval", "A timer ticking a signal — time is just another value.", c.Link("examples/stopwatch/"))
			@card("Filter", "Computed", "A search box deriving a filtered slice, rendered by BindList.", c.Link("examples/filter/"))
		</div>

		<h2>In code</h2>
		<div class="cards">
			@card("Templ basics", "templ", "Components, children, escaping, if/for — the authoring model every astwerk page is built from.", c.Link("examples/templ-basics/"))
			@card("Tree & content", "ssg.Node", "ssg.Node, Build, markdown collections and locales.", c.Link("examples/tree-and-content/"))
			@card("Scripts & routing", "CompileFrom", "CompileFrom and reactive.Router — why the router isn't live here.", c.Link("examples/scripts-and-routing/"))
			@card("wasmwrap & templ", "BindTempl", "Raw DOM scripting without reactive, and re-rendering templ client-side.", c.Link("examples/wasmwrap-and-templ/"))
		</div>
	}
}

templ ExampleCounter(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A counter</h1>
		<p class="lede">
			The smallest useful thing: a signal, a derived value, three handlers.
			The markup is static; only the numbers change. This is the
			WebAssembly path — the same counter generated as plain JavaScript is
			<a href={ c.Link("examples/x-counter/") }>Counter, no WASM</a>.
		</p>
		<div class="demo" id="counter">
			<div class="counter-row">
				<button data-dec aria-label="Decrement">&minus;</button>
				<output data-count>0</output>
				<button data-inc aria-label="Increment">+</button>
				<button data-reset aria-label="Reset">reset</button>
			</div>
			<p class="demo-note">Double: <strong data-doubled>0</strong></p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("State", counterStateSrc) {
			<p>
				<code>NewSignal</code> creates the state. <code>Computed</code>
				derives <code>doubled</code> from it — calling <code>count.Get()</code>
				inside the function is what registers the dependency, so it
				recomputes whenever count changes.
			</p>
		}
		@piece("Hydrating the markup", counterHydrateSrc) {
			<p>
				<code>Hydrate</code> attaches behaviour to markup the page already
				rendered — the demo div above, written by hand. <code>BindText</code>
				re-runs its function whenever something it reads changes, and writes
				the result into the element.
			</p>
		}
		@piece("The buttons", counterHandlersSrc) {
			<p>
				<code>On</code> is <code>el.On</code> plus automatic cleanup inside
				an effect. <code>Update</code> reads and writes atomically:
				increment, decrement and reset each change the signal, and both
				bindings re-run.
			</p>
		}
		@fullSource(counterSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the numbers stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleList(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>A keyed list</h1>
		<p class="lede">
			Add and remove todos. Entries are keyed, so existing nodes are moved
			rather than rebuilt. The compiled-markup version of this is
			<a href={ c.Link("examples/x-todo/") }>Keyed list</a>.
		</p>
		<div class="demo" id="todo">
			<form data-form>
				<input data-new type="text" placeholder="Something to do" aria-label="New item"/>
				<button type="submit" data-add>Add</button>
			</form>
			<ul data-list class="todo-list"></ul>
			<p class="demo-note"><strong data-remaining>0</strong> remaining</p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("State", listStateSrc) {
			<p>
				The model is a slice of items; the DOM is a projection of it.
				<code>draft</code> holds the input while it's being typed.
			</p>
		}
		@piece("The keyed list", listBindSrc) {
			<p>
				<code>BindList</code> takes the parent, a getter, a key function
				and a render function. The key is what makes it patch instead of
				re-render: add a row and only a new <code>&lt;li&gt;</code> is
				created; remove one and only that node is detached. The render
				function runs once per key, so wiring the remove handler inside
				it is safe — it closes over its own row.
			</p>
		}
		@piece("Adding a todo", listAddSrc) {
			<p>
				The field is two-way bound to <code>draft</code>. Submit — Enter
				works — trims, ignores empty text, appends a new item and clears
				the field. <code>items.Update</code> replaces the slice, and
				<code>BindList</code> diffs the keys and patches the DOM to match.
			</p>
		}
		@piece("The count", listCountSrc) {
			<p>
				The remaining count is a text binding over the same slice —
				reading <code>items.Get()</code> re-runs it on every change.
			</p>
		}
		@fullSource(listSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the rows stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleForms(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Two-way form bindings</h1>
		<p class="lede">
			Two number inputs bound two-way, a total derived from them, and a
			checkbox revealing a panel. Nothing here talks to the DOM directly
			except the bindings — the compiled-markup version is
			<a href={ c.Link("examples/x-forms/") }>Forms &amp; computed</a>.
		</p>
		<div class="demo" id="form-demo">
			<p>
				<label>Price <input data-price type="number" value="10" aria-label="Price"/></label>
			</p>
			<p>
				<label>Quantity <input data-qty type="number" value="2" aria-label="Quantity"/></label>
			</p>
			<p class="demo-note">Total: <strong data-total>20.00</strong></p>
			<p>
				<label><input data-tax type="checkbox"/> include tax</label>
			</p>
			<p class="demo-note" data-tax-note style="display:none">
				A checked box can drive visibility, too.
			</p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("State", formStateSrc) {
			<p>
				Two signals hold the inputs; <code>Computed</code> derives the
				total from them — calling <code>price.Get()</code> inside the
				function is what registers the dependency, so the total recomputes
				whenever either input changes.
			</p>
		}
		@piece("The inputs", formInputsSrc) {
			<p>
				<code>BindNumber</code> is two-way — typing writes the signal,
				setting the signal writes the field — and input that isn't a number
				is ignored. The total is a text binding over the memo.
			</p>
		}
		@piece("The checkbox", formCheckboxSrc) {
			<p>
				<code>BindChecked</code> two-way binds a bool, and
				<code>BindShow</code> lets that same signal drive a panel's
				visibility — the note appears and disappears, nothing is rebuilt.
			</p>
		}
		@fullSource(formSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the bindings stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleBindings(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Attribute bindings</h1>
		<p class="lede">
			The WASM twin of the compiled-markup attribute bindings: four
			one-property bindings — <code>href</code>, <code>class</code>,
			<code>disabled</code>, <code>style</code> — each driven by its own
			signal. Change a signal and exactly that property updates, nothing
			else re-renders. The compiled-markup version is
			<a href={ c.Link("examples/x-bindings/") }>Attribute bindings</a>.
		</p>
		<div class="demo" id="bindings-demo">
			<p><a data-bind-href href="https://templ.guide">templ.guide</a></p>
			<p><span data-bind-class>a toggled class</span></p>
			<p><button type="button" data-bind-disabled>save</button></p>
			<p><span data-bind-style>styled text</span></p>
			<div class="counter-row">
				<button type="button" data-toggle-class>toggle class</button>
				<button type="button" data-toggle-disabled>toggle disabled</button>
				<button type="button" data-recolour>recolour</button>
				<button type="button" data-retarget>retarget link</button>
			</div>
		</div>
		<h2>How it works</h2>
		@piece("State", bindingsStateSrc) {
			<p>
				One signal per property the demo touches: the link target, the
				class, the disabled flag and the colour.
			</p>
		}
		@piece("The elements", bindingsElementsSrc) {
			<p>
				Each binding owns one property of one element. <code>BindAttr</code>
				sets a string attribute and removes it when the value is empty;
				<code>BindClass</code> toggles one class; <code>BindStyle</code>
				sets one CSS property.
			</p>
		}
		@piece("The buttons", bindingsButtonsSrc) {
			<p>
				Each button writes its signal — <code>Update</code> toggles a bool,
				<code>Set</code> stores a constant. Because each binding owns its
				property, changing one signal updates exactly that element's
				property — nothing else re-renders.
			</p>
		}
		@fullSource(bindingsSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the bindings stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleAsync(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Async data</h1>
		<p class="lede">
			A <code>Resource</code> exposes its loading and error states as signals
			alongside the data, so all three bind like anything else. The loader
			here sleeps instead of calling <code>wasmwrap.Fetch</code>, but the
			binding code is identical either way.
		</p>
		<div class="demo" id="async-demo">
			<p><button data-reload>Reload</button></p>
			<p class="demo-note" data-status></p>
			<ul data-posts class="todo-list"></ul>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("The resource", asyncResourceSrc) {
			<p>
				<code>NewResource</code> runs the loader on its own goroutine and
				exposes <code>Data</code>, <code>Err</code> and
				<code>Loading</code> as ordinary signals — you always read the
				result back through <code>Data.Get()</code>.
			</p>
		}
		@piece("The status line", asyncStatusSrc) {
			<p>
				All three states bind like anything else. The loader here sleeps
				instead of fetching, but the code is identical either way.
			</p>
		}
		@piece("The list", asyncListSrc) {
			<p>
				<code>posts.Data.Get</code> feeds <code>BindList</code> exactly
				like any other signal — loading, error and data are all the same
				model.
			</p>
		}
		@piece("Reload", asyncReloadSrc) {
			<p>
				<code>Reload</code> re-runs the loader. A generation counter
				discards a stale response, so an old, slow load can't overwrite
				newer data.
			</p>
		}
		@fullSource(asyncSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the status stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleCanvas(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Canvas</h1>
		<p class="lede">
			A typed 2D context and an animation loop, with the drawing buffer
			matched to the device pixel ratio so it stays sharp.
		</p>
		<div class="demo" id="canvas-demo">
			<canvas data-canvas width="600" height="200"></canvas>
			<p>
				<button data-toggle>Pause</button>
				<span class="demo-note">Move the pointer over the canvas.</span>
			</p>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("The context", canvasContextSrc) {
			<p>
				<code>AsCanvas</code> and <code>Context2D</code> wrap the same
				objects <code>getContext("2d")</code> returns, in Go types.
				<code>FitToDisplay</code> matches the pixel buffer to the CSS size
				times the device pixel ratio — skipping it is why canvas drawings
				look blurry on high-DPI screens.
			</p>
		}
		@piece("The pointer", canvasPointerSrc) {
			<p>
				Pointer moves write a signal. <code>PosIn</code> gives coordinates
				relative to the canvas, whatever its position on the page.
			</p>
		}
		@piece("The loop", canvasLoopSrc) {
			<p>
				<code>RequestAnimationFrame</code> reschedules itself, handing the
				frame's delta time to the callback; the returned
				<code>cancel</code> stops the loop. The loop reads the pointer with
				<code>Peek</code>, not <code>Get</code>, because it redraws every
				frame anyway.
			</p>
		}
		@fullSource(canvasSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the animation stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleStopwatch(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Stopwatch</h1>
		<p class="lede">
			A running timer ticks an <code>elapsed</code> signal and a text binding
			renders it — the display doesn't know or care that it's a timer.
			Compiled markup has no combinator for "every 100ms"; this is what
			<code>wasmwrap.SetInterval</code> is for, so this demo is
			WebAssembly-only.
		</p>
		<div class="demo" id="stopwatch-demo">
			<p><output data-time>0:00.0</output></p>
			<div class="counter-row">
				<button data-start>Start</button>
				<button data-reset>Reset</button>
			</div>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("State", stopwatchStateSrc) {
			<p>
				One signal, holding seconds as a float. It starts at zero and nothing
				about it says "timer" — it's a value like any other.
			</p>
		}
		@piece("The tick", stopwatchTickSrc) {
			<p>
				<code>SetInterval</code> runs the function every 100ms; the returned
				<code>cancel</code> stops it. The tick is the only place that knows
				this demo has anything to do with time.
			</p>
		}
		@piece("The display", stopwatchDisplaySrc) {
			<p>
				<code>BindText</code> re-runs on every tick because it reads
				<code>elapsed.Get()</code> — the formatting is just a function of the
				value, so it can be as simple or as fancy as you like.
			</p>
		}
		@piece("Start, pause, reset", stopwatchControlsSrc) {
			<p>
				The start button flips between starting and cancelling the interval
				and relabels itself. Reset just writes zero — the display updates on
				its own.
			</p>
		}
		@fullSource(stopwatchSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the time stays put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleFilter(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Filtering a list</h1>
		<p class="lede">
			A two-way bound search box drives a <code>Computed</code> slice, and
			<code>BindList</code> renders whatever it contains. The list never
			knows a filter exists — it just renders the slice it's given.
		</p>
		<div class="demo" id="filter-demo">
			<p><input data-query type="search" placeholder="Filter the posts…" aria-label="Filter posts"/></p>
			<p class="demo-note"><strong data-count>5</strong> of 5 posts</p>
			<ul data-results class="todo-list"></ul>
		</div>
		@templates.WasmScript(c, "demo")

		<h2>How it works</h2>
		@piece("State", filterStateSrc) {
			<p>
				The posts are a plain slice — no signals, nothing reactive about
				them. The only state is the search box: <code>BindValue</code> is
				two-way, so typing writes <code>query</code> and setting the signal
				would write the field.
			</p>
		}
		@piece("The filter", filterComputedSrc) {
			<p>
				<code>Computed</code> derives the matching slice from
				<code>query</code> — it re-runs on every keystroke because it reads
				<code>query.Get()</code>. An empty query returns everything, so the
				filter is off by default.
			</p>
		}
		@piece("The list and count", filterListSrc) {
			<p>
				<code>BindList</code> renders the filtered slice with the same keyed
				patching as the <a href={ c.Link("examples/list/") }>keyed list</a>;
				the count is a text binding over the same slice.
			</p>
		}
		@fullSource(filterSrc)
		<details>
			<summary>How this demo runs</summary>
			<p>
				<code>scripts/demo.go</code> is compiled to <code>demo.wasm</code>
				by <code>CompileFrom</code> and loaded by <code>WasmScript</code> —
				see <a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp;
				WebAssembly</a>. Without WebAssembly the page still renders; only
				the results stay put.
			</p>
		</details>
		<noscript>
			<p class="warn">This demo needs WebAssembly.</p>
		</noscript>
	}
	@templates.WasmScript(c, "demo")
}

templ ExampleTreeAndContent(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Tree &amp; content</h1>
		<p class="lede">
			These build a site rather than run in one, so they're real code rather
			than a hydrated widget.
		</p>

		<h2 id="building-the-tree">Building the tree</h2>
		<p>
			<code>ssg.Node</code> and <code>Build</code> are the entire mechanism —
			this is what generates this site. See
			<a href={ c.Link("docs/the-node-tree/") }>The Node tree</a>.
		</p>
		@templates.CodeBlock(treeSrc)
		<details>
			<summary>Why relative URLs</summary>
			<p>
				<code>RelativeURLs</code> makes one build work opened from disk, at
				a localhost root, and under a subpath — <code>BaseURL</code> only
				feeds <code>Ctx.URL</code>, for canonical tags. See
				<a href={ c.Link("docs/ctx/") }>Ctx &amp; URLs</a>.
			</p>
		</details>

		<h2 id="markdown-collections">Markdown collections</h2>
		<p>
			<code>content.LoadDir</code> plus <code>Node.Generate</code> turns a
			directory of markdown into one index page and one page per file, with
			no path arithmetic. See
			<a href={ c.Link("docs/content-and-collections/") }>Content &amp; collections</a>.
		</p>
		@templates.CodeBlock(collectionSrc)

		<h2 id="locales">Locales</h2>
		<p>
			A locale's subtree is derived from the base tree — you list only the
			pages that genuinely differ, and everything else is mirrored with the
			prefix set. See <a href={ c.Link("docs/i18n/") }>Locales &amp; i18n</a>.
		</p>
		@templates.CodeBlock(localeSrc)
	}
}

templ ExampleScriptsAndRouting(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>Scripts &amp; routing</h1>

		<h2 id="compiling-scripts">Compiling scripts</h2>
		<p>
			<code>CompileFrom</code> is what turned <code>scripts/demo.go</code>
			into the WebAssembly running the demos in this section — no bundler, no
			<code>package.json</code>. See
			<a href={ c.Link("docs/scripts-and-wasm/") }>Scripts &amp; WebAssembly</a>.
		</p>
		@templates.CodeBlock(scriptsSrc)
		<details>
			<summary>What the build produced</summary>
			<p>
				<code>scripts/demo.go</code> became
				<code>build/scripts/demo.wasm</code>, with Go's
				<code>wasm_exec.js</code> copied in beside it — exactly what
				<code>WasmScript</code> loads on the demo pages above.
			</p>
		</details>

		<h2 id="client-side-routing">Client-side routing</h2>
		<p>
			<code>reactive.Router</code> swaps views against the real address bar,
			which is exactly why it isn't embedded live on this page — a demo
			router would hijack this site's own navigation. This site's docs
			sidebar and pager are plain links, not a router; this is the shape a
			single-page app takes instead. See
			<a href={ c.Link("docs/reactive/") }>reactive</a>.
		</p>
		@templates.CodeBlock(routerSrc)
	}
}

templ ExampleWasmwrapAndTempl(c ssg.Ctx, prev, next *templates.NavItem) {
	@examplePage(c, prev, next) {
		<h1>wasmwrap &amp; templ</h1>

		<h2 id="wasmwrap-without-reactive">wasmwrap without reactive</h2>
		<p>
			<code>reactive</code> is optional. Every other demo in this section
			uses it, but <code>wasmwrap</code> alone is enough for scripting that
			doesn't need signals — a nav toggle is three lines. See
			<a href={ c.Link("docs/wasmwrap/") }>wasmwrap</a>.
		</p>
		@templates.CodeBlock(wasmwrapSrc)
		<details>
			<summary>Why select { "{" }{ "}" } is there</summary>
			<p>
				When <code>main</code> returns, the WASM instance exits and every
				handler dies with it. <code>select {}</code> blocks forever, keeping
				the module alive for the click handler.
			</p>
		</details>

		<h2 id="re-rendering-templ-client-side">Re-rendering templ client-side</h2>
		<p>
			<code>BindTempl</code> runs a templ component in the browser and
			assigns the result as innerHTML — convenient for a display-only
			fragment, wrong for anything interactive, since everything inside is
			destroyed and rebuilt on every update. See
			<a href={ c.Link("docs/reactive/") }>reactive</a>.
		</p>
		@templates.CodeBlock(bindTemplSrc)
		<details>
			<summary>Why BindTempl loses state</summary>
			<p>
				The component renders to a string, and the string is assigned as
				<code>innerHTML</code> — there is nothing to patch against, so the
				whole subtree is replaced and focus, scroll and selection go with
				the old nodes.
			</p>
		</details>

		<p>
			For layouts, an SEO head and an RSS feed ready to copy in, see
			<a href={ c.Link("docs/starter-templates/") }>Starter templates</a>.
		</p>
	}
}

const counterStateSrc = `count := reactive.NewSignal(0)
doubled := reactive.Computed(func() int { return count.Get() * 2 })`

const counterHydrateSrc = `reactive.Hydrate("#counter", func(root wasmwrap.Element) {
	reactive.BindText(root.Find("[data-count]"), func() string {
		return strconv.Itoa(count.Get())
	})
	reactive.BindText(root.Find("[data-doubled]"), func() string {
		return strconv.Itoa(doubled.Get())
	})
})`

const counterHandlersSrc = `reactive.On(root.Find("[data-inc]"), "click", func(wasmwrap.Event) {
	count.Update(func(v int) int { return v + 1 })
})
reactive.On(root.Find("[data-dec]"), "click", func(wasmwrap.Event) {
	count.Update(func(v int) int { return v - 1 })
})
reactive.On(root.Find("[data-reset]"), "click", func(wasmwrap.Event) {
	count.Set(0)
})`

const counterSrc = `count := reactive.NewSignal(0)
doubled := reactive.Computed(func() int { return count.Get() * 2 })

reactive.Hydrate("#counter", func(root wasmwrap.Element) {
	reactive.BindText(root.Find("[data-count]"), func() string {
		return strconv.Itoa(count.Get())
	})
	reactive.BindText(root.Find("[data-doubled]"), func() string {
		return strconv.Itoa(doubled.Get())
	})

	reactive.On(root.Find("[data-inc]"), "click", func(wasmwrap.Event) {
		count.Update(func(v int) int { return v + 1 })
	})
	reactive.On(root.Find("[data-dec]"), "click", func(wasmwrap.Event) {
		count.Update(func(v int) int { return v - 1 })
	})
	reactive.On(root.Find("[data-reset]"), "click", func(wasmwrap.Event) {
		count.Set(0)
	})
})`

const listStateSrc = `type Item struct {
	ID   string
	Text string
}

items := reactive.NewSignal([]Item{
	{ID: "1", Text: "Read the docs"},
	{ID: "2", Text: "Build something"},
})
draft := reactive.NewSignal("")`

const listBindSrc = `reactive.BindList(list, items.Get,
	func(it Item) string { return it.ID },
	func(it Item) wasmwrap.Element {
		row := wasmwrap.Create("li")
		remove := wasmwrap.Create("button").SetText("remove")
		reactive.On(remove, "click", func(wasmwrap.Event) {
			items.Update(func(all []Item) []Item {
				return slices.DeleteFunc(all, func(o Item) bool {
					return o.ID == it.ID
				})
			})
		})
		return row.Append(wasmwrap.Create("span").SetText(it.Text), remove)
	})`

const listAddSrc = `reactive.On(form, "submit", func(e wasmwrap.Event) {
	e.PreventDefault()
	text := strings.TrimSpace(draft.Get())
	if text == "" {
		return
	}
	items.Update(func(all []Item) []Item {
		return append(all, Item{ID: fmt.Sprintf("%d", len(all)+1), Text: text})
	})
	draft.Set("")
})`

const listCountSrc = `reactive.BindText(remaining, func() string {
	return strconv.Itoa(len(items.Get()))
})`

const listSrc = `type Item struct {
	ID   string
	Text string
}

items := reactive.NewSignal([]Item{
	{ID: "1", Text: "Read the docs"},
	{ID: "2", Text: "Build something"},
})
draft := reactive.NewSignal("")

reactive.Hydrate("#todo", func(root wasmwrap.Element) {
	field := root.Find("[data-new]")
	reactive.BindValue(field, draft)

	reactive.On(root.Find("[data-form]"), "submit", func(e wasmwrap.Event) {
		e.PreventDefault()
		text := strings.TrimSpace(draft.Get())
		if text == "" {
			return
		}
		items.Update(func(all []Item) []Item {
			return append(all, Item{ID: fmt.Sprintf("%d", len(all)+1), Text: text})
		})
		draft.Set("")
	})

	reactive.BindText(root.Find("[data-remaining]"), func() string {
		return strconv.Itoa(len(items.Get()))
	})

	reactive.BindList(root.Find("[data-list]"), items.Get,
		func(it Item) string { return it.ID },
		func(it Item) wasmwrap.Element {
			row := wasmwrap.Create("li")
			remove := wasmwrap.Create("button").SetText("remove")
			reactive.On(remove, "click", func(wasmwrap.Event) {
				items.Update(func(all []Item) []Item {
					return slices.DeleteFunc(all, func(o Item) bool {
						return o.ID == it.ID
					})
				})
			})
			return row.Append(wasmwrap.Create("span").SetText(it.Text), remove)
		})
})`

