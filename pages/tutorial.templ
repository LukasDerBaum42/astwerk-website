package pages

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/LukasDerBaum42/astwerk-website/templates"
	x "github.com/LukasDerBaum42/astwerk/x"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// tutCount is the state behind the live counter on the interactivity step.
var tutCount = x.Named("count", 0)

// tutLang is the state behind the live language switcher on the locale step.
var tutLang = x.Named("lang", "en")

// tutTreeAbout and tutTreeStyle are the node toggles on the tree step's live
// demo: which nodes are in the tree, reflected in the output tree below. Named
// because the effect script reads them as about.get() and style.get().
var (
	tutTreeAbout = x.Named("about", false)
	tutTreeStyle = x.Named("style", false)
)

// counter is the live widget from step 8, running on the tutorial page itself.
templ counter() {
	<div class="demo">
		<div class="counter-row">
			<span class="counter-value">@x.Text(tutCount)</span>
			@x.El("button", x.On("click", tutCount.Set(tutCount.Add(1)))) {
				+
			}
		</div>
	</div>
}

// TutorialNav is the sidebar for the tutorial, in step order: an overview and
// ten steps, each building on the last.
var TutorialNav = []templates.NavGroup{
	{
		Items: []templates.NavItem{
			{Label: "Build a site", Path: "tutorial/"},
			{Label: "1. Setup", Path: "tutorial/1-setup/"},
			{Label: "2. The tree", Path: "tutorial/2-the-tree/"},
			{Label: "3. A layout", Path: "tutorial/3-a-layout/"},
			{Label: "4. More pages", Path: "tutorial/4-more-pages/"},
			{Label: "5. A collection", Path: "tutorial/5-a-collection/"},
			{Label: "6. Styles", Path: "tutorial/6-styles/"},
			{Label: "7. A locale", Path: "tutorial/7-a-locale/"},
			{Label: "8. Interactivity", Path: "tutorial/8-interactivity/"},
			{Label: "9. The dev loop", Path: "tutorial/9-the-dev-loop/"},
			{Label: "10. Ship it", Path: "tutorial/10-ship-it/"},
			},
		},
	}

	// tutorialSteps returns the ten numbered steps, skipping the overview entry
	// (the first item in TutorialNav). The overview's progress checklist is built
	// from this, so it cannot drift from the sidebar order.
	func tutorialSteps() []templates.NavItem {
		if len(TutorialNav) == 0 {
			return nil
		}
		return TutorialNav[0].Items[1:]
	}

// tutorialStep returns the step number of a tutorial page
// ("tutorial/3-a-layout/" → 3), or 0 for pages that aren't numbered steps.
func tutorialStep(path string) int {
	parts := strings.Split(strings.Trim(path, "/"), "/")
	head, _, _ := strings.Cut(parts[len(parts)-1], "-")
	n, err := strconv.Atoi(head)
	if err != nil {
		return 0
	}
	return n
}

// tutorialPage wraps one step in the tutorial sidebar and pager.
templ tutorialPage(c ssg.Ctx, prev, next *templates.NavItem) {
	@templates.Layout(c, "Tutorial", TutorialNav) {
		if tutorialStep(c.Path) > 0 {
			@stepProgress(tutorialStep(c.Path))
		}
		<article class="prose">
			{ children... }
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

// stepProgress is the per-step tracker: a progress bar for all ten steps, a
// "complete this step" checkbox, and checkmarks in the sidebar. State is shared
// with the overview's checklist through the same localStorage key.
templ stepProgress(step int) {
	<div class="step-progress">
		<div class="progress-bar"><span data-progress></span></div>
		<span class="progress-note" data-progress-note></span>
		<label class="step-done">
			<input type="checkbox" data-step={ fmt.Sprintf("%d", step) }/> Complete this step
		</label>
	</div>
	<script>
		(() => {
			const KEY = "astwerk-tutorial-steps";
			const total = 10;
			const box = document.querySelector(".step-progress [data-step]");
			const bar = document.querySelector(".step-progress .progress-bar span");
			const note = document.querySelector(".step-progress .progress-note");
			const done = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));

			const render = () => {
				if (bar) bar.style.width = Math.round((done.size / total) * 100) + "%";
				if (note) note.textContent = done.size + " / " + total + " complete";
				if (box) box.checked = done.has(box.dataset.step);
				document.querySelectorAll(".sidebar-group a").forEach((a) => {
					const m = (a.getAttribute("href") || "").match(/tutorial\/(\d+)-/);
					a.classList.toggle("done", m ? done.has(m[1]) : false);
				});
			};

			if (box) box.addEventListener("change", () => {
				if (box.checked) done.add(box.dataset.step);
				else done.delete(box.dataset.step);
				localStorage.setItem(KEY, JSON.stringify(Array.from(done)));
				render();
			});

			render();
		})();
	</script>
}

// localeDemo is a live EN/DE switcher for step 7: the same page in two
// languages — what BuildLocales generates, demonstrated with x.
templ localeDemo() {
	<div class="demo locale-demo">
		<div class="counter-row">
			@x.El("button", x.On("click", tutLang.Set(x.Lit("en")))) {
				English
			}
			@x.El("button", x.On("click", tutLang.Set(x.Lit("de")))) {
				Deutsch
			}
		</div>
		<p data-en><strong>My Site</strong> — A portfolio built with astwerk.</p>
		<p data-de style="display:none"><strong>Meine Seite</strong> — Ein Portfolio, gebaut mit astwerk.</p>
		@x.Effect() {
			<script>
				const en = document.querySelector("[data-en]");
				const de = document.querySelector("[data-de]");
				en.style.display = lang.get() === "en" ? "" : "none";
				de.style.display = lang.get() === "de" ? "" : "none";
				document.querySelectorAll(".locale-demo button").forEach((b, i) => {
					const on = (i === 0 && lang.get() === "en") || (i === 1 && lang.get() === "de");
					b.classList.toggle("on", on);
					b.setAttribute("aria-pressed", String(on));
				});
			</script>
		}
	</div>
}

// treeDemo is step 2's live version of the tree: the output tree changes as
// you toggle nodes in — the same tree the coming steps build up. With both
// toggles off it shows exactly what step 2's build writes.
templ treeDemo() {
	<div class="demo tree-demo">
		<p class="demo-note">The tree is the site — toggle the nodes the next steps add:</p>
		<div class="counter-row">
			@x.El("button", x.On("click", tutTreeAbout.Set(x.Not(tutTreeAbout)))) {
				about
			}
			@x.El("button", x.On("click", tutTreeStyle.Set(x.Not(tutTreeStyle)))) {
				style
			}
		</div>
		<pre class="tree-output" data-tree-output>build/
└── index.html</pre>
		@x.Effect() {
			<script>
				const render = () => {
					const items = ["index.html"];
					if (about.get()) items.push("about/");
					if (style.get()) items.push("style/");
					const lines = ["build/"];
					items.forEach((it, i) => {
						const last = i === items.length - 1;
						lines.push((last ? "└── " : "├── ") + it);
						if (it === "about/") lines.push((last ? "    " : "│   ") + "└── index.html");
					});
					return lines.join("\n");
				};
				const out = document.querySelector("[data-tree-output]");
				if (out) out.textContent = render();
				document.querySelectorAll(".tree-demo button").forEach((b, i) => {
					const on = i === 0 ? about.get() : style.get();
					b.classList.toggle("on", on);
					b.setAttribute("aria-pressed", String(on));
				});
			</script>
		}
	</div>
}

// checkpoint is a callout listing the files a step should have produced.
templ checkpoint(files ...string) {
	<aside class="checkpoint">
		<p><strong>Checkpoint</strong> — your files so far:</p>
		<ul>
			for _, f := range files {
				<li><code>{ f }</code></li>
			}
		</ul>
	</aside>
}

// tryit proposes a small experiment and hides the expected outcome behind a
// reveal, so the reader checks their own result before seeing it.
templ tryit(experiment string, expected string) {
	<div class="tryit">
		<p><strong>Try it.</strong> { experiment }</p>
		<details>
			<summary>What you should see</summary>
			<p>{ expected }</p>
		</details>
	</div>
}

// quiz asks one multiple-choice question with instant feedback: picking an
// option reveals right or wrong plus the explanation, and a correct answer
// ticks the step's "complete" box. The checking runs from layout.templ's
// shared script, keyed off the data attributes.
templ quiz(question string, options []string, correct int, why string) {
	<div class="quiz" data-correct={ fmt.Sprintf("%d", correct) }>
		<p class="quiz-question">{ question }</p>
		<div class="quiz-options">
			for i, opt := range options {
				<button type="button" class="quiz-option" data-opt={ fmt.Sprintf("%d", i) }>{ opt }</button>
			}
		</div>
		<p class="quiz-feedback" aria-live="polite"></p>
		<p class="quiz-why" hidden>{ why }</p>
		<button type="button" class="quiz-reset" hidden>Try again</button>
	</div>
}

	templ TutorialOverview(c ssg.Ctx, prev, next *templates.NavItem) {
		@tutorialPage(c, prev, next) {
			<h1>Build a site</h1>
			<p class="lede">
				Ten steps from an empty directory to a complete site: pages, a
				layout, a markdown collection, a locale, a live widget, and a dev
				loop. Each step is one change — follow them in order, and every
				snippet here is the whole change for its step. You need Go and the
				templ CLI.
			</p>
			<pre class="install"><code>go install github.com/a-h/templ/cmd/templ@latest</code></pre>
			<p>
				The finished site is plain static HTML that deploys anywhere. If you
				would rather copy a starting point than type one, the
				<a href={ c.Link("docs/starter-templates/") }>starter templates</a>
				are this same shape, pre-written.
			</p>

			@quiz("How does astwerk generate a site?", []string{"From a config file", "From a tree of Go values you write", "By scanning a content directory"}, 1, "You describe the output directory as an ssg.Node tree and call ssg.Build — no config file, no convention scanner.")
			@quiz("What do you need to follow along?", []string{"Node.js and npm", "Go and the templ CLI", "A Docker container"}, 1, "The site is a Go program: you need the go toolchain and the templ CLI, which compiles .templ files to Go.")

			<h2>Your progress</h2>
			<p>
				Tick each step as you finish it. Progress is saved in your browser,
				so you can come back to the same place.
			</p>
			<div class="progress">
				<div class="progress-bar"><span></span></div>
				<span class="progress-note">0 / 10 complete</span>
			</div>
			<ul class="step-list" id="tutorial-steps">
				for i, item := range tutorialSteps() {
					<li>
						<input type="checkbox" data-step={ fmt.Sprintf("%d", i+1) } aria-label={ "Mark " + item.Label + " complete" }/>
						<a href={ c.Link(item.Path) }>{ item.Label }</a>
					</li>
				}
			</ul>
			<script>
				(() => {
					const KEY = "astwerk-tutorial-steps";
					const boxes = Array.from(document.querySelectorAll("#tutorial-steps [data-step]"));
					const bar = document.querySelector(".progress-bar span");
					const note = document.querySelector(".progress-note");
					let done = new Set(JSON.parse(localStorage.getItem(KEY) || "[]"));

					const update = () => {
						let n = 0;
						boxes.forEach((b) => {
							const on = done.has(b.dataset.step);
							b.checked = on;
							b.closest("li").classList.toggle("done", on);
							if (on) n++;
						});
						const pct = boxes.length ? Math.round((n / boxes.length) * 100) : 0;
						if (bar) bar.style.width = pct + "%";
						if (note) note.textContent = n + " / " + boxes.length + " complete";
						document.querySelectorAll(".sidebar-group a").forEach((a) => {
							const m = (a.getAttribute("href") || "").match(/tutorial\/(\d+)-/);
							a.classList.toggle("done", m ? done.has(m[1]) : false);
						});
					};

					boxes.forEach((b) => {
						b.addEventListener("change", () => {
							if (b.checked) done.add(b.dataset.step);
							else done.delete(b.dataset.step);
							localStorage.setItem(KEY, JSON.stringify(Array.from(done)));
							update();
						});
					});

					update();
				})();
			</script>
		}
	}

templ TutorialSetup(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>1. Setup</h1>
		<p>
			A new module, and the two dependencies: astwerk itself, and templ —
			astwerk pages are templ components, and the CLI compiles
			<code>.templ</code> files to Go.
		</p>
		@templates.CodeBlock(setupSrc)
		<p>
			That is the entire setup. There is no config file, no project
			scaffold, and no hidden convention scanner — the next step is
			writing the site.
		</p>
		@checkpoint("go.mod", "go.sum")
		@quiz("What does the templ CLI do?", []string{"Serves the site in development", "Compiles .templ files into Go", "Downloads the astwerk module"}, 1, "astwerk pages are templ components; templ generate compiles the .templ files to Go so go run can build the site.")
		@quiz("What does go get github.com/LukasDerBaum42/astwerk do?", []string{"Installs a global astwerk binary", "Adds astwerk as a dependency in go.mod", "Creates the build directory"}, 1, "go get records the module as a dependency in go.mod and downloads it. astwerk is a library, not a CLI — you never run it directly.")
	}
}

templ TutorialTree(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>2. The tree</h1>
		<p>
			astwerk's entire build mechanism is one function that walks a tree.
			You describe the output directory as Go values — one
			<code>ssg.Node</code> per directory — and call <code>ssg.Build</code>.
			The tree root is the site root; <code>Page</code> renders its
			<code>index.html</code>.
		</p>
		<p>The tree is the site — here it is live; toggle the nodes the next steps add:</p>
		@x.Document(treeDemo())
		@templates.CodeBlock(tutStep2Main)
		<p>
			<code>ssg.Templ</code> adapts a templ component with the
			<code>(title, path, prefix)</code> signature, and the walker fills
			the values in — so a page never has to be told where it lives. The
			first page, <code>pages/home.templ</code>:
		</p>
		@templates.CodeBlockTempl(tutStep2Home)
		<p>Generate the Go and build:</p>
		@templates.CodeBlock(buildCmds)
		<p>
			That writes <code>build/index.html</code> — whatever the component
			renders, verbatim. There is no scanner and no config; the tree is
			the site.
		</p>
		@checkpoint("main.go", "pages/home.templ")
		@quiz("What is a Node?", []string{"One directory in the output, described as a Go value", "A markdown file in the content directory", "A JavaScript module"}, 0, "ssg.Node describes one output directory — Title, Page, Children and the rest — and ssg.Build walks the tree and writes it.")
		@quiz("Where does ssg.Templ get a page's path and prefix?", []string{"You pass them in the tree", "The walker fills them in", "templ generates them"}, 1, "ssg.Templ adapts the (title, path, prefix) signature; the walker knows each page's path and locale and supplies those — you give only the title.")
	}
}

templ TutorialLayout(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>3. A layout</h1>
		<p>
			A real page wants <code>&lt;html&gt;</code>/<code>&lt;head&gt;</code>/
			<code>&lt;body&gt;</code> and a nav — the wrong thing to repeat per
			page. Give the shell its own component that takes children,
			<code>pages/layout.templ</code>:
		</p>
		@templates.CodeBlockTempl(tutLayout)
		<p>
			<code>{ children... }</code> is templ's children mechanism: a caller
			wraps the component instead of passing content in as a parameter.
			Every link goes through <code>prefix</code>, so the same layout
			works in every locale. The home page now wraps it:
		</p>
		@templates.CodeBlockTempl(tutHome)
		@checkpoint("pages/layout.templ")
		@tryit("Add a <footer> to the layout and rebuild.", "Every page gains the footer — build/index.html changes and no new files appear. The layout is the shell, shared by all pages.")
		@quiz("How does a component receive the page's own content?", []string{"As a string parameter", "Through the { children... } mechanism", "From a global variable"}, 1, "A component declares { children... } and callers wrap it — the page's markup is passed as children.")
		@quiz("Why does the layout build every link through prefix?", []string{"templ requires it", "So the same layout works in every locale", "To make the output smaller"}, 1, "A locale subtree renders the same components with prefix set to /de, so links through prefix become /de/… automatically and the layout needs no per-language copy.")
	}
}

templ TutorialMorePages(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>4. More pages</h1>
		<p>
			A page is one entry in the tree — nothing else.
			<code>pages/about.templ</code>:
		</p>
		@templates.CodeBlockTempl(tutAbout)
		<p>And one entry in the tree:</p>
		@templates.CodeBlock(tutTreeAddAbout)
		<p>
			That writes <code>build/about/index.html</code>. The
			<code>Title</code> is what the walker hands the page as its
			<code>title</code> argument — every page gets its title, path and
			locale from the tree it lives in.
		</p>
		@checkpoint("pages/about.templ")
		@tryit("Add a third page — say contact — as one more Children entry.", "build/contact/index.html appears and nothing else changes. A page really is one entry in the tree.")
		@quiz("What does adding a page require?", []string{"A new route in a router", "One entry in the Node tree", "A new .html file in the build directory"}, 1, "A page is one entry in the tree — nothing else. The walker derives the page's title, path and locale from where it lives.")
		@quiz("What does one Children entry produce?", []string{"A directory with index.html", "A route in the router", "A new template file"}, 0, "Each Children key becomes a directory, and the node's Page renders its index.html — build/about/index.html comes from one map entry.")
	}
}

templ TutorialCollection(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>5. A collection</h1>
		<p>
			The list-plus-detail pattern — an index page and one page per
			markdown file — is what the <code>content</code> package exists for.
			Drop a file in <code>content/projects/</code>:
		</p>
		@templates.CodeBlock(tutProjectMD)
		<p>
			The <code>+++</code> block is TOML front matter; the rest renders as
			HTML. The two pages — the index and one page per file — go in
			<code>pages/projects.templ</code>:
		</p>
		@templates.CodeBlockTempl(tutProjects)
		<p>
			<code>main.go</code> gains one function that reads the directory and
			returns a subtree. This is the whole collection mechanism, and it is
			just Go:
		</p>
		@templates.CodeBlock(tutMain)
		<p>
			<code>content.Slugs</code> gives a stable, sorted order (a map range
			would reshuffle the index every build). Each page closure receives
			its <code>ssg.Ctx</code> — title, path, prefix — from the walker,
			same as every other page. Rebuild and you have
			<code>build/projects/</code>, <code>build/projects/hello/</code> and
			one page per file you add from now on.
		</p>
		@checkpoint("content/projects/hello.md", "pages/projects.templ")
		@tryit("Drop a second markdown file into content/projects/ and rebuild.", "build/projects/ gains a second directory — one index page and one page per file, with nothing to update in the tree.")
		@quiz("Why range over content.Slugs instead of the map?", []string{"It is faster", "Map order is random, so the index would reshuffle every build", "Slugs drops pages without front matter"}, 1, "Go randomises map iteration order; Slugs returns a sorted order so builds are reproducible.")
		@quiz("What is the +++ block at the top of a content file?", []string{"YAML front matter", "TOML front matter", "A markdown code fence"}, 1, "The front matter between +++ markers is TOML, decoded into your own struct with content.Decode; the rest of the file renders as markdown.")
	}
}

templ TutorialStyles(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>6. Styles</h1>
		<p>
			<code>CopyFrom</code> copies a directory into the build as-is — the
			escape hatch for anything that isn't a page. Add
			<code>style/style.css</code>, tell the layout about it, and put it
			in the tree:
		</p>
		@templates.CodeBlockTempl(tutStyleLink)
		@templates.CodeBlock(tutStyleTree)
		@checkpoint("style/style.css")
		@tryit("Change a colour in style/style.css and rebuild.", "build/style/style.css updates and nothing else changes. CopyFrom copies as-is: what's in the source directory is what's in the build.")
		@quiz("What does CopyFrom do?", []string{"Copies a directory into the build as-is", "Generates CSS from templ files", "Links a stylesheet into the layout"}, 0, "CopyFrom is the escape hatch for anything that isn't a page — it copies a directory's contents into the output verbatim.")
		@quiz("Where does the style node live?", []string{"In the layout's <head>", "As a node in the tree with CopyFrom", "Inside the content directory"}, 1, "\"style\": {CopyFrom: \"style\"} is a node in the tree — CopyFrom copies the directory into the build as-is.")
	}
}

templ TutorialLocale(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>7. A locale</h1>
		<p>
			A locale's subtree is derived from the base tree — you never write
			the site twice. One line mounts a German mirror of everything:
		</p>
		@templates.CodeBlock(tutLocale)
		<p>
			Rebuild and every page exists under <code>/de/</code> too, rendered
			by the same components with <code>prefix</code> set to
			<code>/de</code> — nav links and <code>&lt;html lang&gt;</code>
			included. The <code>Override</code> map is for the pages that
			genuinely differ; everything else is mirrored on its own. See
			<a href={ c.Link("docs/i18n/") }>Locales &amp; i18n</a>.
		</p>
		<p>Here is that switcher, live — built with the <code>x</code> markers from the next step:</p>
		@x.Document(localeDemo())
		@tryit("Add a second locale — say fr — with one overridden page.", "A French mirror of the whole site appears under /fr/ — pages you didn't override are rendered by the same components with prefix set to /fr.")
		@quiz("Where does a locale's subtree come from?", []string{"You write each translated page by hand", "It is derived from the base tree, with overrides for the pages that differ", "The content package scans a locale directory"}, 1, "BuildLocales mirrors the base tree under the locale's prefix; Override lists only the pages that genuinely differ.")
		@quiz("What does the Override map list?", []string{"Every page in the locale", "Only the pages that differ from the base", "The locale's assets"}, 1, "Everything not named in Override is mirrored automatically; Override patches only the nodes that genuinely differ — the default is the same site.")
	}
}

templ TutorialInteractivity(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>8. Interactivity</h1>
		<p class="lede">
			Static until now. The <code>x</code> package adds live behaviour
			without WASM: markers are templ components that render the current
			value <em>and</em> generate the JavaScript that keeps it live, in
			the same call. The counter below is running right now.
		</p>
		@x.Document(counter())
		<p><code>pages/home.templ</code>:</p>
		@templates.CodeBlockTempl(tutHomeWithCounter)
		<p>
			<code>x.Named</code> creates the state under a fixed name, so scripts can
			read it; <code>x.Text</code> renders the value and generates the binding
			that keeps it in sync, and <code>x.On</code> does the same for the
			handler. <code>x.Document</code> emits the runtime and state declarations
			before its body and the bindings after it. View source on this page: the
			bindings are embedded right here, and no <code>.wasm</code> was
			downloaded. Disable JavaScript and the value still renders — it was
			written statically at build time.
		</p>
		<p>
			The full marker set — bindings, forms, lists, effects — is in
			<a href={ c.Link("docs/x/") }>x — compiled reactive markup</a>.
		</p>
		@quiz("What does @x.Text(count) do?", []string{"Only renders the current value", "Renders the value and generates the JavaScript that keeps it in sync", "Downloads a WASM runtime"}, 1, "Markers render at build time and emit their own binding in the same call — the static value is in the HTML and the generated JavaScript updates it.")
		@tryit("Change the counter's initial value from 0 to 5 and rebuild.", "The button shows 5 before any JavaScript runs — the value is written into the HTML at build time, and the generated script keeps it in sync.")
		@quiz("With JavaScript disabled, what does a page with x markers show?", []string{"Nothing — the markers need JavaScript", "The static values from build time", "A WASM fallback"}, 1, "Markers render their current value into the HTML at build time; the generated JavaScript only keeps it in sync. No JavaScript, no framework — the value is still there.")
	}
}

templ TutorialDevloop(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>9. The dev loop</h1>
		<p>
			<code>go run .</code> is fine once, but you want the build to watch
			and rebuild. The <code>devserver</code> package is that loop. Move
			the tree into a helper so both branches build the same site, and
			add <code>--serve</code>:
		</p>
		@templates.CodeBlock(tutMainServe)
		<p>
			The build runs out of process, because a running Go program cannot
			load new code — editing a <code>.templ</code> recompiles, rebuilds,
			and reloads the browser. A failed build shows its compiler error in
			the browser instead of silently serving the last good output. See
			<a href={ c.Link("docs/dev-server/") }>Dev server</a>.
		</p>
		@tryit("Edit a .templ file while the dev server runs — then introduce a compile error on purpose.", "Each save rebuilds and reloads the browser; a broken build shows its compiler error as an overlay instead of serving stale output.")
		@quiz("Why must the build run out of process?", []string{"It is faster", "A running Go program cannot load newly compiled code", "To avoid port conflicts"}, 1, "Your pages are compiled templ components; an in-process build would re-render the components from the binary that started the server.")
		@quiz("What happens when a build fails?", []string{"The dev server stops", "The error is shown in the browser, the last good output stays", "Nothing — it retries silently"}, 1, "A failed build doesn't stop the server: the compiler error appears as an overlay and is cleared on the next successful build.")
	}
}

templ TutorialShipIt(c ssg.Ctx, prev, next *templates.NavItem) {
	@tutorialPage(c, prev, next) {
		<h1>10. Ship it</h1>
		<p>
			The build directory is the site. Serve it from anywhere — the files
			are plain HTML, CSS and a little JavaScript, with no runtime to
			install.
		</p>
		<p>
			One thing worth knowing before deploying: the layout writes
			<code>/style/style.css</code> and <code>/projects/</code> — fine at
			a domain root, wrong under a subpath (GitHub project Pages serve
			from <code>/repo/</code>). If your site will live under a subpath,
			resolve URLs with <code>Ctx.Asset</code>/<code>Ctx.Link</code> and
			build with <code>RelativeURLs: true</code>; the same build then
			works from disk, at a localhost root, and deployed — see
			<a href={ c.Link("docs/the-node-tree/") }>The Node tree</a>.
		</p>
		<p>
			That's the whole framework: a tree of nodes, pages as templ
			components, collections from markdown, locales derived not written,
			and interactivity compiled at build time. Everything else — the
			router, WASM scripting, SEO head, RSS — is documented under the
			pages on the left.
		</p>
		@tryit("Serve the build directory with any static file server — python3 -m http.server, npx serve, whatever you have.", "The site works from any static server: plain HTML, CSS and a little JavaScript, with no runtime to install.")
		@quiz("How should pages link to assets?", []string{"Write /style/style.css as a literal", "Through Ctx.Asset and Ctx.Link", "Through a path copied out of the build"}, 1, "Ctx.Asset and Ctx.Link are base-aware, so one build works from disk, at a localhost root, and under /repo/.")
		@quiz("What is in the build directory?", []string{"A Go binary and a database", "Plain HTML, CSS and a little JavaScript", "Source code that still needs compiling"}, 1, "Build writes static files — the site is ready to serve from anywhere, with no runtime to install.")
	}
}

const setupSrc = `mkdir mysite && cd mysite
go mod init example.com/mysite
go get github.com/LukasDerBaum42/astwerk github.com/a-h/templ`

const buildCmds = `templ generate
go run .`
