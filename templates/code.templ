package templates

// CodeBlock renders a Go snippet with syntax highlighting.
//
// Highlighting happens at build time — chroma emits styled markup, so no
// JavaScript highlighter ships to the browser. The docs pages get the same
// treatment through goldmark's highlighting extension.
templ CodeBlock(src string) {
	<div class="code">
		@templ.Raw(HighlightGo(src))
	</div>
}

// CodeBlockJS renders a JavaScript snippet with syntax highlighting, for
// showing the output the markers generate.
templ CodeBlockJS(src string) {
	<div class="code">
		@templ.Raw(HighlightJS(src))
	</div>
}

// CodeBlockTempl renders a templ snippet with syntax highlighting: markup as
// HTML, Go inside { expressions } and @component calls as Go.
templ CodeBlockTempl(src string) {
	<div class="code">
		@templ.Raw(HighlightTempl(src))
	</div>
}
