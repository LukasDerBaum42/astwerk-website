package templates

import "github.com/LukasDerBaum42/astwerk/ssg"

// NavItem is one entry in a sidebar or top nav.
type NavItem struct {
	Label string
	Path  string // site-relative, no leading slash: "docs/the-node-tree/"
	// Sub lists this page's own subsections (its h2 headings). They render
	// nested under this item only while it's the active page — showing every
	// page's subsections at once would bury the page list they're supposed to
	// help navigate within.
	Sub []SubItem
}

// SubItem is one in-page anchor, shown nested under its page's sidebar entry.
type SubItem struct {
	Label  string
	Anchor string // "#some-heading", appended to the page's own link
}

// NavGroup is a labelled cluster of sidebar entries. A sidebar with one group
// renders no group heading, so callers with a flat list can leave Title empty.
type NavGroup struct {
	Title string
	Items []NavItem
}

// Layout owns the page shell.
//
// Every URL goes through c.Asset or c.Link rather than being written as a
// literal "/…", because this site is served from /astwerk/ on GitHub Pages. Get
// that wrong and every stylesheet and link 404s once deployed.
templ Layout(c ssg.Ctx, sidebarTitle string, sidebar []NavGroup) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ pageTitle(c.Title) }</title>
			<link rel="icon" href={ c.Asset("public/favicon.svg") } type="image/svg+xml"/>
			<link rel="stylesheet" href={ c.Asset("style/style.css") }/>
			<link rel="stylesheet" href={ c.Asset("style/code.css") }/>
			<link rel="canonical" href={ "https://lukasderbaum42.github.io" + c.URL() }/>
			<meta name="description" content="astwerk — a minimal, no-magic static site generator for Go and templ."/>
			<meta property="og:title" content={ pageTitle(c.Title) }/>
			<meta property="og:type" content="website"/>
			<script>
				// Applied before paint, so a saved preference never flashes the
				// wrong theme. Dark is the default: no key means no attribute, and
				// the stylesheet's :root is already dark.
				(() => {
					const t = localStorage.getItem("theme");
					if (t === "light") document.documentElement.dataset.theme = "light";
				})();
			</script>
		</head>
		<body>
			<a class="skip" href="#main">Skip to content</a>
			<header class="topbar">
				<a class="brand" href={ c.Link("") }>
					<span class="mark">&#9683;</span> astwerk
				</a>
				<nav class="topnav">
					<a href={ c.Link("docs/") } aria-current={ ariaCurrent(c.Path, "docs") }>Docs</a>
					<a href={ c.Link("tutorial/") } aria-current={ ariaCurrent(c.Path, "tutorial") }>Tutorial</a>
					<a href={ c.Link("examples/") } aria-current={ ariaCurrent(c.Path, "examples") }>Examples</a>
					<a href="https://pkg.go.dev/github.com/LukasDerBaum42/astwerk">API</a>
					<a href="https://github.com/LukasDerBaum42/astwerk">GitHub</a>
					<button
						class="theme-toggle"
						id="theme-toggle"
						type="button"
						aria-label="Toggle light and dark theme"
					></button>
				</nav>
			</header>
			if len(sidebar) > 0 {
				<div class="with-sidebar">
					<aside class="sidebar">
						<p class="sidebar-title">{ sidebarTitle }</p>
						for _, group := range sidebar {
							<nav class="sidebar-group">
								if group.Title != "" {
									<p class="sidebar-group-title">{ group.Title }</p>
								}
								for _, item := range group.Items {
									if item.Path == c.Path {
										<a href={ c.Link(item.Path) } class="active" aria-current="page">{ item.Label }</a>
										if len(item.Sub) > 0 {
											<ul class="sidebar-sub">
												for _, sub := range item.Sub {
													<li><a href={ templ.SafeURL(c.Link(item.Path) + sub.Anchor) }>{ sub.Label }</a></li>
												}
											</ul>
										}
									} else {
										<a href={ c.Link(item.Path) }>{ item.Label }</a>
									}
								}
							</nav>
						}
					</aside>
					<main id="main">
						{ children... }
					</main>
				</div>
			} else {
				<main id="main" class="wide">
					{ children... }
				</main>
			}
			<footer class="footer">
				<p>
					astwerk is MIT licensed. This site is built with astwerk —
					<a href="https://github.com/LukasDerBaum42/astwerk-website">its own source</a>
					is in the repo.
				</p>
			</footer>
			<script>
				(() => {
					const btn = document.getElementById("theme-toggle");
					btn.addEventListener("click", () => {
						const light = document.documentElement.dataset.theme === "light";
						if (light) {
							delete document.documentElement.dataset.theme;
							localStorage.setItem("theme", "dark");
						} else {
							document.documentElement.dataset.theme = "light";
							localStorage.setItem("theme", "light");
						}
					});
				})();
			</script>
		</body>
	</html>
}

func pageTitle(t string) string {
	if t == "" || t == "astwerk" {
		return "astwerk — a no-magic static site generator for Go"
	}
	return t + " — astwerk"
}

// ariaCurrent marks a top-nav section as current. templ renders an empty
// attribute value as absent, so "" is the right "not current" answer.
func ariaCurrent(path, section string) string {
	if len(path) >= len(section) && path[:len(section)] == section {
		return "true"
	}
	return ""
}

// Single wraps a flat item list as the one-group case, for callers that don't
// need sections in their sidebar.
func Single(items []NavItem) []NavGroup {
	if len(items) == 0 {
		return nil
	}
	return []NavGroup{{Items: items}}
}
